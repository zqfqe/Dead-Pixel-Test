---
import '../../index.css';
import { pageAlternates, LOCALE_PAIRS } from '../../data/seoLandingPages';
interface Props {
  title: string; description: string; canonicalPath: string;
  lang?: 'en' | 'pt-BR'; legacy?: boolean; noindex?: boolean;
  image?: string; schema?: Record<string, unknown>;
}
const {title,description,canonicalPath,lang='en',legacy=false,noindex=false,image='/logo.svg',schema}=Astro.props;
const isCloudflarePreview = process.env.CF_PAGES === '1' && !!process.env.CF_PAGES_BRANCH && process.env.CF_PAGES_BRANCH !== 'main';
const configuredSiteUrl = isCloudflarePreview ? '' : import.meta.env.PUBLIC_SITE_URL?.trim();
const origin = configuredSiteUrl ? new URL(configuredSiteUrl).origin : '';
const normalizePath = (path: string) => path === '/' ? '/' : path.replace(/\/+$/, '');
const canonical = origin ? new URL(normalizePath(canonicalPath), origin).toString() : undefined;
const alternates = origin ? pageAlternates(canonicalPath) : [];
const shouldNoindex = noindex || !origin;
const navigation = lang==='pt-BR'
  ? [
      {href:'/pt-br/',label:'Teste de pixel'}, {href:'/pt-br/pixel-morto-notebook/',label:'Notebook'},
      {href:'/pt-br/pixel-morto-iphone/',label:'iPhone'}, {href:'/pt-br/teste-de-cores/',label:'Cores'},
      {href:'/pt-br/reparar-pixel-preso/',label:'Pixel preso'},
    ]
  : [
      {href:'/',label:'Dead Pixel Test'}, {href:'/laptop-screen-dead-pixel-test/',label:'Laptop'},
      {href:'/dead-pixel-line-test/',label:'Screen Lines'}, {href:'/image-retention-test/',label:'Retention'},
      {href:'/tests/refresh-rate',label:'Refresh Rate'}, {href:'/tests/local-dimming',label:'Local Dimming'}
    ];
const hasSchema=Boolean(schema);
const googleVerification=import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const currentPath=normalizePath(canonicalPath);
const isNavCurrent=(href:string)=>currentPath===normalizePath(href);
const matchedLocalePair=LOCALE_PAIRS.find(pair=>pair.some(path=>normalizePath(path)===currentPath));
// Preserve the user's current task only when a real, same-purpose translation exists.
const englishHref=matchedLocalePair ? normalizePath(matchedLocalePair[0]) : '/';
const portugueseHref=matchedLocalePair ? normalizePath(matchedLocalePair[1]) : '/pt-br';
const languageFallback=!matchedLocalePair;
---
<!doctype html>
<html lang={lang} data-astro-site="true" data-surface={legacy?'dark':'light'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={legacy?"#08090c":"#0D1416"} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <meta name="description" content={description} />
    {shouldNoindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map(a => <link rel="alternate" hreflang={a.lang} href={new URL(normalizePath(a.path),origin).toString()} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {origin && <meta property="og:image" content={new URL(image,origin).toString()} />}
    {hasSchema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')} />}
  </head>
  <body data-surface={legacy?'dark':'light'} class={legacy?'min-h-screen bg-[#08090c] text-white antialiased':'min-h-screen bg-[#F6F8FB] text-[#101827] antialiased'}>
    {!legacy && <a href="#main-content" class="skip-link">{lang==="pt-BR"?"Pular para o conteúdo principal":"Skip to main content"}</a>}
    {!legacy && <header class="ui-topbar sticky top-0 z-40 border-b border-[#DCE3EA] bg-white/95 backdrop-blur-lg">
      <div class="mx-auto max-w-7xl flex flex-wrap items-center gap-x-4 gap-y-0 px-4 md:min-h-16 md:flex-nowrap md:px-8">
        <a href={lang==='pt-BR'?'/pt-br':'/'} class="ui-brand order-1 flex min-h-14 items-center gap-2 font-bold text-[#101827] shrink-0 md:min-h-16">
          <img src="/logo.svg" alt={lang==="pt-BR"?"Página inicial DeadPixelTest":"DeadPixelTest home"} width="28" height="28" /><span aria-hidden="true">DeadPixelTest</span>
        </a>
        <nav aria-label={lang==='pt-BR'?'Ferramentas':'Tools'} class="ui-main-nav order-3 flex w-full gap-1 overflow-x-auto whitespace-nowrap border-t border-[#E5EBF3] text-sm text-[#344256] md:order-2 md:ml-auto md:w-auto md:border-t-0">
          {navigation.map(n=><a href={normalizePath(n.href)} aria-current={isNavCurrent(n.href)?"page":undefined} class:list={["ui-nav-link flex min-h-11 shrink-0 items-center rounded-lg px-3 py-2 font-medium",isNavCurrent(n.href)?"text-[#125CC9] font-bold":""]}>{n.label}</a>)}
        </nav>
        <div class="ui-language-switch order-2 ml-auto flex min-h-14 shrink-0 items-center gap-2 text-xs md:order-3 md:ml-0 md:min-h-11 md:border-l md:border-[#DCE3EA] md:pl-3">
          <a href={englishHref} lang="en" title={languageFallback?'English home page':'English counterpart'} aria-label={languageFallback?'English home page':'English version of this topic'} class:list={["ui-lang-link",lang==='en'?"ui-lang-current":""]}>EN</a>
          <a href={portugueseHref} lang="pt-BR" title={languageFallback?'Página inicial em português':'Versão em português deste assunto'} aria-label={languageFallback?'Portuguese home page':'Portuguese version of this topic'} class:list={["ui-lang-link",lang==='pt-BR'?"ui-lang-current":""]}>PT-BR</a>
        </div>
      </div>
    </header>}
    <slot />
    {!legacy && <footer class="mt-20 border-t border-[#DCE3EA] bg-white px-4 py-10 text-sm text-[#344256]">
      <div class="mx-auto max-w-7xl flex flex-wrap justify-between gap-5">
        <p>© {new Date().getUTCFullYear()} DeadPixelTest — {lang==='pt-BR'?'Inspeção visual, não laudo técnico.':'Visual self-check, not a hardware certificate.'}</p>
        <nav aria-label={lang==="pt-BR"?"Informações legais e guias":"Site information and guides"} class="flex flex-wrap gap-5"><a href="/blog">{lang==="pt-BR"?"Guias de teste (EN)":"Screen testing guides"}</a><a href="/about">{lang==="pt-BR"?"Sobre":"About"}</a><a href="/contact">{lang==="pt-BR"?"Contato":"Contact"}</a><a href="/privacy-policy">{lang==="pt-BR"?"Privacidade":"Privacy"}</a><a href="/terms-of-service">{lang==="pt-BR"?"Termos":"Terms"}</a></nav>
      </div>
    </footer>}
  </body>
</html>

---
import '../../index.css';
import { pageAlternates } from '../../data/seoLandingPages';
interface Props {
  title: string; description: string; canonicalPath: string;
  lang?: 'en' | 'pt-BR'; legacy?: boolean; noindex?: boolean;
  image?: string; schema?: Record<string, unknown>;
}
const {title,description,canonicalPath,lang='en',legacy=false,noindex=false,image='/logo.svg',schema}=Astro.props;
const configuredSiteUrl = import.meta.env.PUBLIC_SITE_URL?.trim();
const origin = configuredSiteUrl ? new URL(configuredSiteUrl).origin : '';
const normalizePath = (path: string) => path === '/' ? '/' : path.replace(/\/+$/, '');
const canonical = origin ? new URL(normalizePath(canonicalPath), origin).toString() : undefined;
const alternates = origin ? pageAlternates(canonicalPath) : [];
const shouldNoindex = noindex || !origin;
const navigation = lang==='pt-BR'
  ? [
      {href:'/pt-br/',label:'Teste de pixel'}, {href:'/pt-br/pixel-morto-notebook/',label:'Notebook'},
      {href:'/pt-br/pixel-morto-iphone/',label:'iPhone'}, {href:'/pt-br/teste-de-cores/',label:'Cores'},
      {href:'/pt-br/reparar-pixel-preso/',label:'Pixel preso'},
    ]
  : [
      {href:'/',label:'Dead Pixel Test'}, {href:'/laptop-screen-dead-pixel-test/',label:'Laptop'},
      {href:'/dead-pixel-line-test/',label:'Screen Lines'}, {href:'/image-retention-test/',label:'Retention'},
      {href:'/tests/refresh-rate',label:'Refresh Rate'}, {href:'/tests/local-dimming',label:'Local Dimming'}
    ];
const hasSchema=Boolean(schema);
const googleVerification=import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const currentPath=normalizePath(canonicalPath);
const isNavCurrent=(href:string)=>currentPath===normalizePath(href);
---
<!doctype html>
<html lang={lang} data-astro-site="true" data-surface={legacy?'dark':'light'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={legacy?"#08090c":"#F6F8FB"} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <meta name="description" content={description} />
    {shouldNoindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map(a => <link rel="alternate" hreflang={a.lang} href={new URL(normalizePath(a.path),origin).toString()} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {origin && <meta property="og:image" content={new URL(image,origin).toString()} />}
    {hasSchema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')} />}
  </head>
  <body data-surface={legacy?'dark':'light'} class={legacy?'min-h-screen bg-[#08090c] text-white antialiased':'min-h-screen bg-[#F6F8FB] text-[#101827] antialiased'}>
    {!legacy && <a href="#main-content" class="skip-link">{lang==="pt-BR"?"Pular para o conteúdo principal":"Skip to main content"}</a>}
    {!legacy && <header class="sticky top-0 z-40 border-b border-[#DCE3EA] bg-white/95 backdrop-blur-lg shadow-sm">
      <div class="mx-auto max-w-7xl flex min-h-16 items-center gap-4 px-4 md:px-8">
        <a href={lang==='pt-BR'?'/pt-br':'/'} class="flex items-center gap-2 font-bold text-[#101827] shrink-0">
          <img src="/logo.svg" alt="" width="28" height="28" /><span>DeadPixelTest</span>
        </a>
        <nav aria-label={lang==='pt-BR'?'Ferramentas':'Tools'} class="flex gap-3 overflow-x-auto whitespace-nowrap text-sm text-[#344256] ml-auto">
          {navigation.map(n=><a href={normalizePath(n.href)} aria-current={isNavCurrent(n.href)?"page":undefined} class:list={["focus:text-[#125CC9] rounded-md px-1 py-3 hover:text-[#125CC9]",isNavCurrent(n.href)?"text-[#125CC9] font-bold underline underline-offset-8":""]}>{n.label}</a>)}
        </nav>
        <div class="shrink-0 flex gap-2 text-xs border-l border-[#DCE3EA] pl-3">
          <a href="/" lang="en" class={lang==='en'?'font-bold text-[#125CC9]':'hover:text-[#125CC9]'}>EN</a>
          <a href="/pt-br" lang="pt-BR" class={lang==='pt-BR'?'font-bold text-[#125CC9]':'hover:text-[#125CC9]'}>PT-BR</a>
        </div>
      </div>
    </header>}
    <slot />
    {!legacy && <footer class="mt-20 border-t border-[#DCE3EA] bg-white px-4 py-10 text-sm text-[#344256]">
      <div class="mx-auto max-w-7xl flex flex-wrap justify-between gap-5">
        <p>© {new Date().getUTCFullYear()} DeadPixelTest — {lang==='pt-BR'?'Inspeção visual, não laudo técnico.':'Visual self-check, not a hardware certificate.'}</p>
        <nav aria-label={lang==="pt-BR"?"Informações legais":"Legal and information"} class="flex flex-wrap gap-5"><a href="/about">{lang==="pt-BR"?"Sobre":"About"}</a><a href="/contact">{lang==="pt-BR"?"Contato":"Contact"}</a><a href="/privacy-policy">{lang==="pt-BR"?"Privacidade":"Privacy"}</a><a href="/terms-of-service">{lang==="pt-BR"?"Termos":"Terms"}</a></nav>
      </div>
    </footer>}
  </body>
</html>

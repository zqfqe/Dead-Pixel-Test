---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScreenInspection from '../../components/tests/ScreenInspection';
import { SEO_LANDING_PAGES } from '../../data/seoLandingPages';
import { BLOG_POSTS } from '../../data/blog';
import { MENU_ITEMS } from '../../data/menu';
const page={description:'Free online dead pixel test for monitors, laptops and phones. Check dead and stuck pixels with solid colors; no download or automatic diagnosis.'};
const topLinks=[
 {path:'/laptop-screen-dead-pixel-test/',name:'Laptop Dead Pixel Test',sub:'Check your built-in display'},
 {path:'/phone-screen-dead-pixel-test/',name:'Phone Screen Test',sub:'Touch-friendly iPhone and Android inspection'},
 {path:'/dead-pixel-fixer/',name:'Stuck Pixel Check',sub:'Static comparison, no flashing'},
 {path:'/dead-pixel-line-test/',name:'Screen Line Test',sub:'Horizontal and vertical lines'},
 {path:'/image-retention-test/',name:'Image Retention Test',sub:'Temporary persistence and burn-in'},
 {path:'/screen-contrast-test/',name:'Screen Contrast Test',sub:'Grayscale and gradients'},
 {path:'/screen-resolution-test/',name:'Screen Resolution & PPI',sub:'Browser metrics and manual native PPI estimate'},
 {path:'/tests/refresh-rate',name:'Frame Skipping Test',sub:'Browser FPS and external camera'},
 {path:'/tests/local-dimming',name:'Local Dimming Test',sub:'Look for halo effects and blooming'},
 {path:'/tests/color-gradient',name:'Color Banding Test',sub:'Inspect smooth gradient transitions'},
 {path:'/tests/audio-sync',name:'Audio / Video Sync',sub:'Check apparent sound synchronization'}
];
const highlightedPaths=new Set(topLinks.map(item=>item.path.replace(/\/+$/,'') || '/'));
const moreToolGroups: Array<{title:string;items:Array<{title:string;path:string}>}> = [];
let group: (typeof moreToolGroups)[number] | null = null;
for (const item of MENU_ITEMS) {
 if (item.isHeader) {
  group=/^(DISPLAY TESTS|INPUT & GAMING|AUDIO & UTILS)$/.test(item.title)
   ? {title:item.title,items:[]} : null;
  if (group) moreToolGroups.push(group);
  continue;
 }
 const path=(item.path||'').replace(/\/+$/,'')||'/';
 if (group && /^\/(?:tests|tools)\//.test(path) && !highlightedPaths.has(path)) {
  group.items.push({title:item.title,path});
 }
}
const additionalToolCount=moreToolGroups.reduce((total,g)=>total+g.items.length,0);
const isCloudflarePreview = process.env.CF_PAGES === '1' && !!process.env.CF_PAGES_BRANCH && process.env.CF_PAGES_BRANCH !== 'main';
const publicSiteUrl=!isCloudflarePreview && import.meta.env.PUBLIC_SITE_URL ? new URL(import.meta.env.PUBLIC_SITE_URL).origin : undefined;
// Identify the actual site name separately from the free browser application.
const schema={
 '@context':'https://schema.org',
 '@graph':[
  ...(publicSiteUrl?[{'@type':'WebSite',name:'DeadPixelTest',url:publicSiteUrl+'/'}]:[]),
  {'@type':'WebApplication',
   name:'Dead Pixel Test — Screen Visual Inspection',...(publicSiteUrl?{url:publicSiteUrl+'/'}:{}),
   description:page.description,inLanguage:'en',
   applicationCategory:'UtilitiesApplication',operatingSystem:'Web Browser',
   offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}}
 ]
};
---

<BaseLayout title="Dead Pixel Test – Free Online Screen Check | DeadPixelTest"
  description={page.description} canonicalPath="/" lang="en" schema={schema}>
  <main id="main-content" tabindex="-1" class="ui-site-main mx-auto max-w-7xl px-4 pt-7 md:px-8 md:pt-12">
    <div class="ui-home-stage">
      <section class="ui-hero-intro ui-enter" aria-label="Dead pixel test introduction">
        <p class="ui-kicker"><span class="ui-status-dot" aria-hidden="true"></span> DISPLAY DIAGNOSTICS <span class="ui-kicker-id">/ 01</span></p>
        <h1 class="ui-display-title">Dead Pixel Test</h1>
        <p class="ui-headline-sub">See every detail.</p>
        <p class="ui-hero-description">Check any screen with eight solid colors. Find suspicious dots, compare what you see, and record your observations. No installation or automatic diagnosis.</p>
        <div class="ui-hero-metrics" aria-label="Test characteristics">
          <span><span aria-hidden="true">↗</span> No installation</span>
          <span><span aria-hidden="true">◈</span> Eight solid colors</span>
          <span><span aria-hidden="true">◎</span> Manual inspection</span>
        </div>
        <div class="ui-preview-instrument" aria-hidden="true">
          <div class="ui-preview-head"><span>VISUAL SAMPLE / COLOR FIELD</span><span>1920 × 1080</span></div>
          <div class="ui-preview-screen">
            <div class="ui-preview-target"><span class="ui-preview-dot"></span></div>
          </div>
          <div class="ui-preview-bottom"><span class="ui-preview-signal"></span><span>01 / 08 · STATIC PATTERN</span><span>RGB</span></div>
        </div>
      </section>
      <section class="ui-workbench-panel ui-enter" aria-label="Interactive screen inspection workspace">
        <div class="ui-workbench-heading">
          <p class="ui-kicker">SCREEN CHECK <span class="ui-kicker-id">/ READY</span></p>
          <h2 class="ui-workbench-title">Inspect your screen</h2>
          <p class="ui-workbench-description">Start with a color. Observe the surface. Record only what you can actually see.</p>
        </div>
        <div class="ui-inspection-shell">
          <p class="ui-workbench-label">Start your screen check</p>
          <ScreenInspection client:only="react" mode="pixels" lang="en" />
          <noscript>
            <div role="note" class="mt-4 rounded-lg border border-amber-400/40 bg-neutral-900 p-4 text-sm text-white">
              <strong>JavaScript is disabled.</strong> The full-screen color test, manual spot marking and report download need JavaScript. Enable it and reload this page to inspect your display. No account is required.
            </div>
          </noscript>
          <p class="ui-workbench-footnote">Black, white, red, green, blue and more. Keyboard arrows and touch-friendly controls. Record suspect spots for manual rechecks.</p>
        </div>
      </section>
    </div>

    <aside class="ui-help-card ui-enter ui-enter-delayed" aria-labelledby="inspection-guide-title">
      <div class="ui-guide-heading">
        <div><p class="ui-overline">READ THE SCREEN · FIVE SIGNALS</p><h2 id="inspection-guide-title">What to look for</h2></div>
        <p>Each background reveals a different symptom. Compare several colors before deciding whether a mark is on the screen surface or in the panel.</p>
      </div>
      <ol class="ui-checklist">
        <li><strong>White screen</strong><span>Unusually dark points that might otherwise blend in.</span></li>
        <li><strong>Black screen</strong><span>Unusually bright or colored points.</span></li>
        <li><strong>Red, green and blue</strong><span>Spots that do not behave like their surroundings.</span></li>
        <li><strong>Whole lines</strong><span>Investigate separately from an isolated pixel.</span></li>
        <li><strong>Faint old image</strong><span>Compare on neutral gray in the retention test.</span></li>
      </ol>
      <div class="ui-guide-foot"><a href="/what-is-a-dead-pixel">See symptom examples and next steps <span aria-hidden="true">↗</span></a><p>This is a visual self-check, not a certified diagnosis.</p></div>
    </aside>

    <section class="ui-section ui-tool-library" aria-labelledby="tool-library-heading">
      <div class="ui-section-heading">
        <div><p class="ui-overline">EXPLORE / SCREEN & DEVICE TOOLS</p><h2 id="tool-library-heading">More display and device tests</h2></div>
        <p>Choose the test that matches what you see. Each opens its own guided workflow.</p>
      </div>
      <div class="ui-tools-grid">
        {topLinks.map((link,i) => <a href={link.path.replace(/\/$/,'') || '/'} class:list={["ui-feature-card",i===0?"ui-feature-card-primary":""]}>
          <div class="ui-feature-card-top"><span class="ui-card-index">{String(i+1).padStart(2,'0')} / {i<7?'SCREEN CHECK':'DEVICE TOOL'}</span><span class="ui-card-arrow" aria-hidden="true">↗</span></div>
          <h3>{link.name}</h3><p>{link.sub}</p>
        </a>)}
      </div>
      <details class="mt-8 rounded-xl border border-[#DCE3EA] bg-white p-5 md:p-7" id="additional-tools">
        <summary class="cursor-pointer text-lg font-semibold text-[#101827] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#125CC9]">Browse {additionalToolCount} additional browser tests</summary>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-[#344256]">Find focused checks for text sharpness, motion, mouse and keyboard input, touch, audio and other device behavior. Each test has its own setup instructions and limits.</p>
        <div class="mt-6 grid gap-6 md:grid-cols-3">
          {moreToolGroups.filter(g=>g.items.length>0).map(g=><section aria-label={g.title}>
            <h3 class="mb-3 text-sm font-bold uppercase tracking-wide text-[#31583F]">{g.title.replace(' & ',' and ')}</h3>
            <ul class="space-y-2">{g.items.map(item=><li>
              <a class="inline-block py-1 text-sm font-semibold text-[#125CC9] underline-offset-4 hover:underline" href={item.path}>{item.title}</a>
            </li>)}</ul>
          </section>)}
        </div>
      </details>
    </section>

    <section class="ui-editorial-grid ui-section">
      <article class="ui-editorial-card">
        <p class="ui-overline">UNDERSTAND / 01</p>
        <h2>How to identify a dead pixel</h2>
        <p>A dead pixel does not produce the expected light output. It may appear as a consistently dark spot, particularly against white. A stuck subpixel may remain red, green or blue, while dust and protective-film marks can look similar. Compare several backgrounds before drawing conclusions.</p>
        <a href="/what-is-a-dead-pixel">Understand dead and stuck pixels <span aria-hidden="true">↗</span></a>
      </article>
      <article class="ui-editorial-card">
        <p class="ui-overline">UNDERSTAND / 02</p>
        <h2>Why test several colors?</h2>
        <p>The same defect can look different on a black, white or primary-color field. Static color screens help you locate an abnormal spot, but cannot measure monitor luminance, native refresh rate or physical panel health. Never press or heat the display in an attempt to fix a pixel.</p>
        <a href="/pt-br">Teste de pixel morto em português <span aria-hidden="true">↗</span></a>
      </article>
    </section>
    <section class="ui-section" aria-labelledby="screen-guides-heading">
      <div class="ui-section-heading">
        <div><p class="ui-overline">LEARN / SCREEN PROBLEMS</p><h2 id="screen-guides-heading">Practical screen testing guides</h2></div>
        <p>Understand the symptom before changing monitor settings or contacting the manufacturer.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {BLOG_POSTS.map(post=><article class="rounded-xl border border-[#DCE3EA] bg-white p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-[#31583F]">{post.category}</p>
          <h3 class="mt-3 text-lg font-bold text-[#101827]"><a class="text-[#125CC9] hover:underline" href={'/blog/'+post.slug}>{post.title}</a></h3>
          <p class="mt-3 text-sm leading-6 text-[#344256]">{post.excerpt}</p>
        </article>)}
      </div>
      <p class="mt-5 text-sm"><a href="/blog" class="font-semibold text-[#125CC9] hover:underline">Browse all screen testing guides</a></p>
    </section>
    <section class="ui-faq-section ui-section" aria-labelledby="faq-title">
      <div class="ui-section-heading"><div><p class="ui-overline">HELP / FAQ</p><h2 id="faq-title">Common questions</h2></div></div>
      <div class="ui-faq-grid">
        <article class="ui-info-card"><h3>Can a webpage detect dead pixels automatically?</h3><p>No. The test displays patterns; you inspect the physical screen. A browser cannot read the panel's actual damaged pixels.</p></article>
        <article class="ui-info-card"><h3>Can a dead pixel be fixed online?</h3><p>A physically damaged pixel cannot be repaired by a webpage. Avoid rapid flashing, heat and pressure. Ask the manufacturer about warranty options.</p></article>
      </div>
    </section>
  </main>
</BaseLayout>

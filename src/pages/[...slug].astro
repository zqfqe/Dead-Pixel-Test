---
import BaseLayout from '../layouts/BaseLayout.astro';
import App from '../../App';
import ScreenInspection from '../../components/tests/ScreenInspection';
import { BLOG_POSTS } from '../../data/blog';
import { MENU_ITEMS } from '../../data/menu';
import { SEO_LANDING_PAGES, pageAlternates } from '../../data/seoLandingPages';

const oldPaths = MENU_ITEMS.filter(item=>!item.isHeader && item.path && item.path!=='/' && item.path.startsWith('/')).map(item=>item.path);
const additionalPaths=['/tests/dead-pixel','/about','/contact','/privacy-policy','/terms-of-service',
  ...BLOG_POSTS.map(post=>'/blog/'+post.slug)];
const pagePaths=[...new Set([...oldPaths,...additionalPaths,...SEO_LANDING_PAGES.filter(p=>p.path!=='/').map(p=>p.path)])];
export function getStaticPaths() {
 const allPaths=[...new Set([
   ...MENU_ITEMS.filter(item=>!item.isHeader && item.path && item.path!=='/' && item.path.startsWith('/')).map(item=>item.path),
   '/tests/dead-pixel','/about','/contact','/privacy-policy','/terms-of-service',
   ...BLOG_POSTS.map(post=>'/blog/'+post.slug),
   ...SEO_LANDING_PAGES.filter(p=>p.path!=='/').map(p=>p.path)
 ])];
 return allPaths.map(path=>({params:{slug:path.split('/').filter(Boolean).join('/')},props:{routePath:path}}));
}
const {routePath} = Astro.props;
const route=String(routePath);
const normalized=route.replace(/\/$/,'')||'/';
const newPage=SEO_LANDING_PAGES.find(p=>(p.path.replace(/\/$/,'')||'/')===normalized);
const article=BLOG_POSTS.find(p=>'/blog/'+p.slug===normalized);
const blogIndex=normalized==='/blog';
const isLegacy=!newPage && !article && !blogIndex;
const title=newPage?.title || article?.title || (
 normalized==='/tests/refresh-rate'?'Frame Skipping Test – Monitor Browser FPS':
 normalized==='/tests/local-dimming'?'Local Dimming & Blooming Test':
 normalized==='/tests/color-gradient'?'Color Banding & Gradient Test':
 normalized==='/tests/audio-sync'?'Audio Video Sync Test':
 normalized==='/tests/dead-pixel'?'Dead Pixel Test – Free Online Screen Check':
 (MENU_ITEMS.find(m=>m.path===normalized)?.title || normalized.split('/').filter(Boolean).slice(-1)[0]?.replaceAll('-',' ') || 'Screen Test')+' | DeadPixelTest'
);
const description=newPage?.description || article?.excerpt || (
 normalized==='/tests/refresh-rate'?'Check browser animation frame cadence, and use an external camera to investigate monitor frame skipping.':
 normalized==='/tests/local-dimming'?'Visually inspect monitor local dimming, halos and blooming using high contrast patterns.':
 normalized==='/tests/color-gradient'?'Check monitor color gradients and possible banding with browser-based test patterns.':
 normalized==='/tests/audio-sync'?'Check apparent audio and video synchronization with a browser-based interactive test.':
 'Free browser-based display and device diagnostics. Manual testing and observation; no hardware certification.'
);
const isBR=newPage?.lang==='pt-BR';
const locale = newPage?.lang ?? 'en';
const inspectionMode=newPage?.mode==='guide'?'pixels':newPage?.mode==='resolution'?'pixels':newPage?.mode??'pixels';
const others=SEO_LANDING_PAGES.filter(p=>p.lang===locale && p.path!==newPage?.path).slice(0,7);
const docType=newPage?.mode==='guide'?'WebPage':'WebApplication';
const structuredData=newPage?{
 '@context':'https://schema.org','@type':docType,name:newPage.h1,
 url:'https://deadpixeltest.cc'+newPage.path.replace(/\/$/,''),description:newPage.description,
 ...(docType==='WebApplication'?{applicationCategory:'UtilitiesApplication',operatingSystem:'Web Browser',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}}:{})
}:undefined;
const canonicalPath=normalized==='/tests/dead-pixel'?'/':newPage?.path||route;
---
<BaseLayout title={title} description={description} canonicalPath={canonicalPath} lang={locale} legacy={isLegacy} schema={structuredData}>
{newPage ? (
  <main class="max-w-6xl mx-auto px-4 pt-8 md:px-8">
    <nav aria-label="Breadcrumb" class="text-sm text-neutral-400 mb-7"><a href="/" class="hover:text-blue-400">Home</a> / {newPage.h1}</nav>
    <header class="rounded-2xl border border-blue-500/20 bg-neutral-950 p-6 md:p-10">
      <p class="uppercase tracking-widest text-xs text-blue-400 font-bold">{isBR?'Ferramenta online gratuita':'Free browser-based screen check'}</p>
      <h1 class="text-3xl md:text-5xl font-bold mt-3 tracking-tight">{newPage.h1}</h1>
      <p class="text-neutral-300 max-w-3xl text-lg leading-8 mt-5 mb-7">{newPage.lead}</p>
      {newPage.mode==='resolution' ? (
         <div class="grid md:grid-cols-2 gap-4">
           <div class="border border-white/10 p-4 rounded-lg"><h2 class="font-semibold mb-2">CSS screen and viewport</h2><p class="text-neutral-300">The values below are reported by the browser, not by the display panel’s hardware specifications.</p></div>
           <div class="border border-white/10 p-4 rounded-lg"><dl id="screen-metrics" class="font-mono text-sm text-neutral-300">Enable JavaScript for live screen and viewport metrics.</dl></div>
         </div>
       ) : (
         <div class="p-5 rounded-xl border border-white/10 bg-black">
           <ScreenInspection client:only="react" mode={inspectionMode} lang={newPage.lang} />
         </div>
       )}
       <p class="mt-5 text-xs text-neutral-500">{isBR?'Inspeção manual. Sem certificação.':'Manual visual self-check. Not an automated hardware diagnosis or certificate.'}</p>
    </header>
    <section class="mt-12 grid md:grid-cols-[2fr_1fr] gap-10">
      <div>
        <h2 class="text-2xl font-bold mb-5">{isBR?'Como fazer o teste':'How to run this check'}</h2>
        <ol class="space-y-4">{newPage.steps.map((step,i)=><li class="flex gap-4 text-neutral-300 leading-7"><span class="text-blue-400 font-bold">{i+1}.</span><span>{step}</span></li>)}</ol>
      </div>
      <aside class="border border-white/10 bg-white/5 rounded-xl p-5">
        <h2 class="text-lg font-bold mb-3">{isBR?'Antes de começar':'Before you start'}</h2>
        <p class="text-neutral-300 leading-7">{isBR?'Limpe a tela, evite reflexos e confira filtros de luz azul ou HDR.':'Clean the screen, reduce reflections, and note HDR, zoom and adaptive brightness settings.'}</p>
      </aside>
    </section>
    <section class="mt-12"><h2 class="text-2xl font-bold mb-5">{isBR?'Limitações e segurança':'Limitations and safety'}</h2>
      <div class="grid md:grid-cols-2 gap-4">{newPage.notes.map(note=><p class="border border-white/10 bg-white/5 p-5 rounded-xl text-neutral-300 leading-7">{note}</p>)}</div>
    </section>
    <section class="mt-12"><h2 class="text-2xl font-bold mb-5">{isBR?'Perguntas frequentes':'Frequently asked questions'}</h2>
      <div class="space-y-4">{newPage.faq.map(item=><article class="rounded-xl border border-white/10 p-5"><h3 class="font-semibold text-lg">{item.question}</h3><p class="text-neutral-300 leading-7 mt-3">{item.answer}</p></article>)}</div>
    </section>
    <section class="mt-12"><h2 class="text-2xl font-bold mb-5">{isBR?'Testes relacionados':'Related tests'}</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">{others.map(other=><a class="rounded-lg p-4 border border-white/10 hover:border-blue-500/60 text-neutral-200" href={other.path.replace(/\/$/,'')}>{other.h1}</a>)}</div>
    </section>
  </main>
) : article ? (
  <main class="max-w-4xl mx-auto px-5 pt-12">
    <nav aria-label="Breadcrumb"><a href="/blog" class="text-blue-400">← All guides</a></nav>
    <article class="prose prose-invert max-w-none py-8">
      <p class="text-sm uppercase tracking-widest text-blue-400">{article.category} · {article.date}</p>
      <h1 class="text-4xl font-bold">{article.title}</h1>
      <p class="text-neutral-400 leading-8">{article.excerpt}</p>
      <div class="mt-8 blog-article" set:html={article.content} />
    </article>
    <a href="/" class="inline-block text-blue-400 mt-5">Open the dead pixel test →</a>
  </main>
) : blogIndex ? (
  <main class="max-w-6xl mx-auto px-5 py-12">
    <h1 class="text-4xl font-bold mb-4">Screen Testing Guides</h1><p class="text-neutral-400 mb-8">Practical explanations and display troubleshooting articles.</p>
    <div class="grid md:grid-cols-2 gap-5">{BLOG_POSTS.map(post=><a href={'/blog/'+post.slug} class="border border-white/10 rounded-xl p-5 hover:border-blue-500/60">
      <h2 class="text-xl font-bold mb-2">{post.title}</h2><p class="text-neutral-400">{post.excerpt}</p></a>)}</div>
  </main>
) : (
  <>
    <App client:only="react" />
    <section class="mx-auto max-w-5xl px-6 pb-16 pt-5 text-neutral-400 leading-7" aria-label="Display test information">
      <h2 class="text-xl font-semibold text-white mb-3">About {title}</h2>
      <p>{description}</p>
      <p class="mt-3">The interactive tool loads in your browser. This is a user-operated display check; appearance depends on the display, browser and operating-system settings.</p>
      <p class="mt-4"><a class="text-blue-400" href="/">Dead Pixel Test</a> · <a class="text-blue-400" href="/tests/local-dimming">Local Dimming</a> · <a class="text-blue-400" href="/tests/color-gradient">Color Gradient</a></p>
    </section>
  </>
)}
{newPage?.mode==='resolution' && <script is:inline>
  (function() {
    const el=document.getElementById('screen-metrics');
    if(!el)return;
    const update=()=>{
      el.replaceChildren();
      const data=[
        ['Screen width (CSS px)',window.screen.width],
        ['Screen height (CSS px)',window.screen.height],
        ['Viewport width (CSS px)',window.innerWidth],
        ['Viewport height (CSS px)',window.innerHeight],
        ['Device pixel ratio (DPR)',window.devicePixelRatio],
        ['Available screen width (CSS px)',window.screen.availWidth]
      ];
      for(const [name,value] of data){
        const dt=document.createElement('dt');dt.textContent=String(name);
        const dd=document.createElement('dd');dd.textContent=String(value);dd.style.marginBottom='0.75rem';
        el.append(dt,dd);
      }
    };
    window.addEventListener('resize',update);update();
  })();
  </script>}
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteInformation from '../components/SiteInformation.astro';
import App from '../../App';
import ScreenInspection from '../../components/tests/ScreenInspection';
import { BLOG_POSTS } from '../../data/blog';
import { MENU_ITEMS } from '../../data/menu';
import { SEO_LANDING_PAGES, LOCALE_PAIRS } from '../../data/seoLandingPages';
import { GEO_ANSWERS } from '../../data/geoAnswers';

const oldPaths = MENU_ITEMS.filter(item=>!item.isHeader && item.path && item.path!=='/' && item.path.startsWith('/')).map(item=>item.path);
const additionalPaths=['/tests/dead-pixel','/about','/contact','/privacy-policy','/terms-of-service',
  ...BLOG_POSTS.map(post=>'/blog/'+post.slug)];
const pagePaths=[...new Set([...oldPaths,...additionalPaths,...SEO_LANDING_PAGES.filter(p=>p.path!=='/').map(p=>p.path)])];
export function getStaticPaths() {
 const allPaths=[...new Set([
   ...MENU_ITEMS.filter(item=>!item.isHeader && item.path && item.path!=='/' && item.path.startsWith('/')).map(item=>item.path),
   '/tests/dead-pixel','/about','/contact','/privacy-policy','/terms-of-service',
   ...BLOG_POSTS.map(post=>'/blog/'+post.slug),
   ...SEO_LANDING_PAGES.filter(p=>p.path!=='/').map(p=>p.path)
 ])];
 return allPaths.map(path=>({params:{slug:path.split('/').filter(Boolean).join('/')},props:{routePath:path}}));
}
const {routePath} = Astro.props;
const route=String(routePath);
const normalized=route.replace(/\/$/,'')||'/';
const newPage=SEO_LANDING_PAGES.find(p=>(p.path.replace(/\/$/,'')||'/')===normalized);
const geoAnswer=GEO_ANSWERS[normalized] ?? GEO_ANSWERS[normalized+'/'];
const article=BLOG_POSTS.find(p=>'/blog/'+p.slug===normalized);
const blogIndex=normalized==='/blog';
const informationalRoutes=['/about','/contact','/privacy-policy','/terms-of-service'] as const;
const infoPage=informationalRoutes.includes(normalized as (typeof informationalRoutes)[number]);
const isLegacy=!newPage && !article && !blogIndex && !infoPage;
const legacySeoGuides: Record<string,{seoTitle:string;heading:string;intro:string;steps:string[];limits:string[]}> = {
  "/tests/uniformity": {
    "seoTitle": "Screen Uniformity Test – Black, White & Gray | DeadPixelTest",
    "heading": "How to check screen uniformity",
    "intro": "Compare solid black, white and gray fields to observe visible brightness patches, tint or corner glow. This is a visual screen-uniformity check, not a luminance measurement.",
    "steps": [
      "Use ordinary room lighting and a comfortable display brightness.",
      "Compare black, white and neutral gray fields, noting patches and edge differences.",
      "Change viewing angle and check whether any apparent glow moves.",
      "Repeat with a normal photo or application before deciding whether to contact support."
    ],
    "limits": [
      "The browser cannot measure physical nits or panel uniformity percentages.",
      "Phone photos may exaggerate dark-scene glow; no screen defect is certified."
    ]
  },
  "/tests/text-clarity": {
    "seoTitle": "Text Clarity Test – Sharpness & Scaling | DeadPixelTest",
    "heading": "How to evaluate text clarity",
    "intro": "Compare test lettering and fine edges to spot visible softness, colored fringes and scaling effects. Text clarity depends on browser zoom and display configuration.",
    "steps": [
      "Check your operating system scaling and browser zoom before testing.",
      "View small and large text at your normal reading distance.",
      "Compare the same text in another application or display profile.",
      "If letters look blurred, review the panel's native resolution and operating system text settings."
    ],
    "limits": [
      "Subpixel rendering and antialiasing differ between operating systems and browsers.",
      "A screenshot or webpage cannot certify the optical sharpness of a display."
    ]
  },
  "/tests/color-distance": {
    "seoTitle": "Color Distance Test – Compare Screen Swatches | DeadPixelTest",
    "heading": "How to compare color swatches",
    "intro": "View neighboring screen colors to see whether subtle shades appear distinct. The perceived difference changes with profiles, ambient light and display calibration.",
    "steps": [
      "Use the same picture mode and brightness during comparisons.",
      "View color pairs against a neutral surrounding area.",
      "Compare differences on a second display only as an informal reference.",
      "If colors collapse together, check your color profile and display settings."
    ],
    "limits": [
      "This tool does not measure color difference in Delta E or chromaticity.",
      "Vision, browser color management and panel gamut affect what appears distinct."
    ]
  },
  "/tests/response-time": {
    "seoTitle": "Monitor Response Time Visual Test – Motion | DeadPixelTest",
    "heading": "How to observe motion response artifacts",
    "intro": "Use browser-drawn moving patterns to look for trails, overshoot or motion blur. The tool helps visual comparison but cannot measure a panel's millisecond response specification.",
    "steps": [
      "Check the operating system display refresh setting and a stable browser tab.",
      "Observe the moving object at normal brightness and viewing distance.",
      "If available, compare the monitor's overdrive modes under the same conditions.",
      "Repeat the comparison with different content or a high-speed camera for further investigation."
    ],
    "limits": [
      "Browser frame pacing and display refresh settings can change the observed trail.",
      "Gray-to-gray response time and input latency need calibrated equipment to measure."
    ]
  },
  "/tests/gamma": {
    "seoTitle": "Monitor Gamma Test – Visual Midtone Patterns | DeadPixelTest",
    "heading": "How to compare gamma and midtone appearance",
    "intro": "Use midtone patterns to inspect whether grays appear unusually light or dark. Gamma visual checks are sensitive to scaling, viewing distance and browser processing.",
    "steps": [
      "Confirm your browser zoom, display scaling and HDR state.",
      "View the midtone reference pattern at the recommended distance for your display.",
      "Compare the visual impression after adjusting only one display setting.",
      "Return to original settings if you cannot reliably judge a difference."
    ],
    "limits": [
      "No browser-only pattern establishes a calibrated gamma response curve.",
      "Antialiasing, dithering and color profiles can change the result."
    ]
  },
  "/tests/viewing-angle": {
    "seoTitle": "Monitor Viewing Angle Test – Color & Contrast | DeadPixelTest",
    "heading": "How to observe display viewing angles",
    "intro": "Compare perceived brightness, color and contrast while looking at the screen from different positions. The browser supplies reference patterns, not an optical angle measurement.",
    "steps": [
      "Begin at your normal seating position using a familiar test pattern.",
      "Move your head gently to the left and right and note any color shift.",
      "Repeat above and below the center line without touching the screen.",
      "Compare observations with your expected viewing conditions."
    ],
    "limits": [
      "The webpage cannot know your head position or measure viewing angles in degrees.",
      "Room reflections and different panel technologies can affect the visual result."
    ]
  },
  "/tests/brightness": {
    "seoTitle": "Monitor Brightness Test – Dark & Light Levels | DeadPixelTest",
    "heading": "How to inspect screen brightness levels visually",
    "intro": "Use light and dark reference fields to observe visible clipping or unevenness at your current screen settings. This is a brightness visibility check, not a nit-meter.",
    "steps": [
      "Use a comfortable brightness in your normal room lighting.",
      "Compare black, white and near-black or near-white levels.",
      "If details disappear, examine HDR and display range settings before changing brightness.",
      "Check normal images again after any adjustment."
    ],
    "limits": [
      "Browsers cannot directly read calibrated physical luminance in nits.",
      "Do not infer a precise brightness level or monitor fault from the page."
    ]
  },
  "/tests/contrast": {
    "seoTitle": "Screen Contrast Test – Black & White Detail | DeadPixelTest",
    "heading": "How to check visible contrast and clipping",
    "intro": "Compare black-to-white steps to find shadow crush or highlight clipping. These reference patterns do not measure your panel's physical contrast ratio.",
    "steps": [
      "Use your normal viewing brightness and picture preset.",
      "Look for separation among dark-gray and bright-gray patches.",
      "Check whether HDR, video-range or auto-contrast processing changes the result.",
      "Change one setting at a time and record what you observe."
    ],
    "limits": [
      "Contrast ratio requires calibrated light measurements.",
      "Browser color management and OLED/LCD processing can affect the displayed steps."
    ]
  },
  "/tests/matrix": {
    "seoTitle": "Matrix Rain Display Animation – Visual Demo | DeadPixelTest",
    "heading": "About the Matrix Rain visual demo",
    "intro": "Run the Matrix-style animation as an optional motion and display demonstration. It is decorative browser content, not a dead-pixel or performance diagnosis.",
    "steps": [
      "Start the animation only if you want to observe this visual effect.",
      "Keep screen brightness comfortable during use.",
      "Exit the animation when finished and return to a static test for defect inspection."
    ],
    "limits": [
      "The animation does not indicate whether a monitor is healthy or defective.",
      "Animation speed depends on browser scheduling and hardware performance."
    ]
  },
  "/tools/burn-in-wiper": {
    "seoTitle": "OLED Display Pattern Demo – No Burn-In Repair | DeadPixelTest",
    "heading": "How to use the optional OLED pattern demo safely",
    "intro": "This legacy tool offers changing colors, static noise and moving-line patterns for short visual comparisons. It does not repair OLED burn-in or stuck pixels.",
    "steps": [
      "Use ordinary brightness and choose a short session duration.",
      "Select a pattern only if it is comfortable to watch.",
      "Stop the demonstration with Escape, the exit control or by leaving the tab.",
      "For residual-image questions, compare a neutral gray field in the separate retention guide."
    ],
    "limits": [
      "Avoid unattended sessions and high-contrast motion if sensitive to light changes.",
      "Permanent OLED burn-in cannot be reversed by a browser animation."
    ]
  },
  "/tools/input-lag": {
    "seoTitle": "Input Lag Visual Test – Browser Timing Caveats | DeadPixelTest",
    "heading": "How to investigate apparent input lag",
    "intro": "Use the browser input-lag demonstration to compare perceived input and visual response. Camera, display, browser and device delays can all affect timing.",
    "steps": [
      "Use the same monitor, input device and system settings for repeat comparisons.",
      "Follow the tool's visible event and camera or observation instructions.",
      "Repeat several times and note outliers rather than relying on one click.",
      "For an objective figure, use synchronized external measurement equipment."
    ],
    "limits": [
      "A browser cannot isolate monitor-only input latency from the rest of the system.",
      "Network, USB, camera and operating-system scheduling can influence timing."
    ]
  },
  "/tools/reaction-time": {
    "seoTitle": "Reaction Time Test – Click Response | DeadPixelTest",
    "heading": "How to run a browser reaction-time check",
    "intro": "Try a simple visual stimulus and record how quickly you respond. Results combine human response, input device latency and browser scheduling.",
    "steps": [
      "Close distracting tabs and use your normal mouse or touchscreen.",
      "Watch for the visible stimulus, then respond as instructed.",
      "Repeat a few trials and compare the distribution rather than a single number.",
      "Avoid comparing results across devices as if they were calibrated measurements."
    ],
    "limits": [
      "The tool is not a clinical or neurological assessment.",
      "Input devices, display refresh and browser timing influence recorded milliseconds."
    ]
  },
  "/tools/double-click-test": {
    "seoTitle": "Mouse Double-Click Test – Check Event Behavior | DeadPixelTest",
    "heading": "How to test for unexpected mouse double-clicks",
    "intro": "Click the test target to observe whether a single action produces multiple browser click events. This can help investigate a worn mouse switch or a software configuration issue.",
    "steps": [
      "Keep the pointer inside the designated test area.",
      "Perform separate single clicks and note unexpected double events.",
      "Repeat after changing the double-click interval in operating-system settings if relevant.",
      "Test another mouse or browser to narrow down the cause."
    ],
    "limits": [
      "Browser events cannot identify an internal switch fault with certainty.",
      "Operating-system settings and deliberate rapid clicks affect the result."
    ]
  },
  "/tools/mouse-polling": {
    "seoTitle": "Mouse Polling Rate Test – Browser Event Estimate | DeadPixelTest",
    "heading": "How to interpret a mouse event-rate estimate",
    "intro": "Move your mouse in the test area to sample how often the browser receives movement events. Browser-observed Hz is not the same as USB hardware polling rate.",
    "steps": [
      "Move the pointer continuously inside the sampling surface.",
      "Compare the reported event-rate estimate across several passes.",
      "Use Reset Statistics before repeating under different system conditions.",
      "Treat the observed cadence as a browser-level signal, not a hardware guarantee."
    ],
    "limits": [
      "Browsers can coalesce mouse events or throttle callbacks.",
      "The estimate cannot certify a mouse's advertised 125, 500, 1000 or higher Hz USB polling rate."
    ]
  },
  "/tools/keyboard": {
    "seoTitle": "Online Keyboard Test – Check Key Events | DeadPixelTest",
    "heading": "How to check keyboard events in the browser",
    "intro": "Press keys and observe which input events reach the page. This can help identify unresponsive keys or unusual key mappings.",
    "steps": [
      "Focus the keyboard test before typing.",
      "Press individual keys and observe which keys the browser reports.",
      "Repeat suspicious keys in another application or with another keyboard.",
      "Check language layouts, shortcuts and system remapping if reported keys differ."
    ],
    "limits": [
      "Browser shortcuts and reserved system keys may not be reported to websites.",
      "This check does not certify switch force, rollover or electrical reliability."
    ]
  },
  "/tools/controller": {
    "seoTitle": "Gamepad & Controller Test – Browser Buttons | DeadPixelTest",
    "heading": "How to inspect controller input events",
    "intro": "Connect a compatible controller and observe button, trigger or stick signals made available through the browser Gamepad API.",
    "steps": [
      "Connect the controller and press a button to expose it to the browser.",
      "Move sticks and press buttons while watching the test readouts.",
      "Repeat suspicious inputs in a game or system controller panel.",
      "Check connection and permissions if no controller appears."
    ],
    "limits": [
      "Gamepad support and button mappings vary across browsers and operating systems.",
      "A browser cannot certify internal hardware calibration or repair drift."
    ]
  },
  "/tools/touch": {
    "seoTitle": "Touch Screen Test – Visual Touch Points | DeadPixelTest",
    "heading": "How to inspect touchscreen input",
    "intro": "Use the touch surface to see where the browser receives taps and gestures. This helps observe missing areas or unexpected multi-touch behavior.",
    "steps": [
      "Open the test on a touch-capable device.",
      "Tap or drag across different parts of the test area.",
      "Try simultaneous touches if the device and browser support them.",
      "Compare the same area in another app if input appears absent."
    ],
    "limits": [
      "Browser gestures can be intercepted by the operating system.",
      "A touch event test cannot certify digitizer hardware condition."
    ]
  },
  "/tools/color-blindness": {
    "seoTitle": "Color Blindness Simulation – Visual Preview | DeadPixelTest",
    "heading": "What a color-vision simulation can and cannot show",
    "intro": "Preview approximate changes to image colors under selected simulation settings. This is a visual demonstration, not a medical color-vision screening.",
    "steps": [
      "Choose an image or available sample in the tool.",
      "Compare the original with a selected simulation.",
      "Use the result for accessibility design discussion, not personal diagnosis.",
      "For any vision concerns, consult an appropriate eye-care professional."
    ],
    "limits": [
      "Displays and color profiles alter what simulations look like.",
      "Simulation algorithms cannot diagnose or measure an individual's vision."
    ]
  },
  "/tools/webcam": {
    "seoTitle": "Webcam & Microphone Test – Local Browser Check | DeadPixelTest",
    "heading": "How to check webcam and microphone access",
    "intro": "Verify that the browser can request a camera or microphone and display local preview or input behavior. Access requires your permission.",
    "steps": [
      "Connect the device and review the browser permission prompt.",
      "Select the intended camera or microphone if more than one exists.",
      "Observe the local preview and test microphone input at a comfortable level.",
      "Stop the test and revoke permissions if you no longer need access."
    ],
    "limits": [
      "Permission success does not certify sensor color accuracy or audio latency.",
      "The test should not imply that the browser has access before the user grants permission."
    ]
  },
  "/tools/speaker-test": {
    "seoTitle": "Speaker & Headphone Test – Audio Channels | DeadPixelTest",
    "heading": "How to check speaker and headphone output",
    "intro": "Play user-initiated reference audio to verify that your chosen speakers or headphones produce sound from expected channels.",
    "steps": [
      "Lower system volume before beginning.",
      "Start playback and listen for channel or volume differences.",
      "Try wired and wireless outputs if troubleshooting routing issues.",
      "Stop playback and check audio settings if one channel is missing."
    ],
    "limits": [
      "This is not a calibrated speaker frequency-response or hearing test.",
      "Room acoustics, audio mixing and Bluetooth codecs affect the result."
    ]
  },
  "/tools/ruler": {
    "seoTitle": "Online Physical Ruler – Calibrate CSS Size | DeadPixelTest",
    "heading": "How to use a browser ruler accurately",
    "intro": "Use the screen ruler as an approximate measurement aid after calibrating against a real object. CSS pixels do not automatically correspond to physical millimeters.",
    "steps": [
      "Set browser zoom and display scaling to known values.",
      "Compare the displayed ruler against a physical ruler or known-size reference.",
      "Adjust the on-screen calibration until the reference aligns.",
      "Recalibrate whenever display, zoom or orientation changes."
    ],
    "limits": [
      "Without physical calibration, length readings are estimates.",
      "Browser DPR and CSS pixels do not provide true panel pixel pitch by themselves."
    ]
  },
  "/tools/ppi-calculator": {
    "seoTitle": "PPI Calculator – Physical Screen Pixel Density | DeadPixelTest",
    "heading": "How to calculate screen pixel density",
    "intro": "Enter the physical native resolution and diagonal size to calculate pixels per inch. The browser cannot discover a panel's native hardware resolution for you.",
    "steps": [
      "Find the display's native pixel dimensions in its specifications.",
      "Enter width, height and diagonal size in inches.",
      "Confirm that the values describe the physical panel, not browser CSS pixels.",
      "Compare the calculated density with your viewing needs without treating it as a measured optical property."
    ],
    "limits": [
      "Presets are illustrative; confirm your specific model specifications.",
      "PPI is a calculation from supplied dimensions, not a browser hardware measurement."
    ]
  }
};
const staticSeoMeta: Record<string,{title:string;description:string}> = {
 '/blog':{title:'Screen Testing Guides – Pixels, Color & Display Settings | DeadPixelTest',description:'Practical dead pixel, screen uniformity and color testing guides with safe browser tools and clearly stated measurement limits.'},
 '/about':{title:'About DeadPixelTest – Visual Screen Testing Tools',description:'Learn how DeadPixelTest provides browser-based screen inspections and why our user-observed checks are not hardware certification.'},
 '/contact':{title:'Contact DeadPixelTest – Screen Test Support',description:'Find site contact information and guidance about browser-based screen tests, feedback and privacy requests.'},
 '/privacy-policy':{title:'Privacy Policy | DeadPixelTest',description:'Read how DeadPixelTest handles browser-based inspections, local report files, optional device permissions and hosting request data.'},
 '/terms-of-service':{title:'Terms of Service | DeadPixelTest',description:'Understand the usage conditions and accuracy limitations of DeadPixelTest browser-based visual inspection tools.'}
};

const title=newPage?.title || article?.title || staticSeoMeta[normalized]?.title || legacySeoGuides[normalized]?.seoTitle || (
 normalized==='/tests/refresh-rate'?'Frame Skipping Test – Monitor Browser FPS':
 normalized==='/tests/local-dimming'?'Local Dimming & Blooming Test':
 normalized==='/tests/color-gradient'?'Color Banding & Gradient Test':
 normalized==='/tests/audio-sync'?'Audio Video Sync Test':
 normalized==='/tests/dead-pixel'?'Dead Pixel Test – Free Online Screen Check':
 (MENU_ITEMS.find(m=>m.path===normalized)?.title || normalized.split('/').filter(Boolean).slice(-1)[0]?.replaceAll('-',' ') || 'Screen Test')+' | DeadPixelTest'
);
const description=newPage?.description || article?.excerpt || staticSeoMeta[normalized]?.description || legacySeoGuides[normalized]?.intro || (
 normalized==='/tests/refresh-rate'?'Check browser animation frame cadence, and use an external camera to investigate monitor frame skipping.':
 normalized==='/tests/local-dimming'?'Visually inspect monitor local dimming, halos and blooming using high contrast patterns.':
 normalized==='/tests/color-gradient'?'Check monitor color gradients and possible banding with browser-based test patterns.':
 normalized==='/tests/audio-sync'?'Check apparent audio and video synchronization with a browser-based interactive test.':
 'Free browser-based display and device diagnostics. Manual testing and observation; no hardware certification.'
);
const isBR=newPage?.lang==='pt-BR';
const locale = newPage?.lang ?? 'en';
const inspectionMode=newPage?.mode==='guide'?'pixels':newPage?.mode==='resolution'?'pixels':newPage?.mode??'pixels';
const others=SEO_LANDING_PAGES.filter(p=>p.lang===locale && p.path!==newPage?.path)
 .sort((a,b)=>Number(b.mode===newPage?.mode)-Number(a.mode===newPage?.mode)).slice(0,7);
const localePair=LOCALE_PAIRS.find(([en,pt])=>[en,pt].some(path=>(path.replace(/\/$/,'')||'/')===normalized));
const switchLocaleHref=isBR
 ? (localePair ? (localePair[0].replace(/\/$/,'')||'/') : '/')
 : (localePair ? (localePair[1].replace(/\/$/,'')||'/') : '/pt-br');
const pixelDifferences=isBR?[
 {appearance:'Ponto escuro em fundo claro',meaning:'Pode indicar um pixel que não está emitindo a luz esperada, mas poeira e sujeira podem parecer semelhantes.',action:'Limpe o vidro com cuidado e compare vermelho, verde e azul.'},
 {appearance:'Ponto colorido em vários fundos',meaning:'Pode envolver um subpixel preso. A aparência depende da tecnologia do painel.',action:'Registre quais cores exibem o ponto sem pressionar ou aquecer a tela.'},
 {appearance:'Faixa horizontal ou vertical',meaning:'Linhas contínuas podem estar ligadas ao painel, cabo ou sinal, e não apenas a um pixel.',action:'Compare outra entrada, cabo ou monitor quando possível.'},
 {appearance:'Contorno de uma imagem antiga',meaning:'Pode ser persistência temporária ou desgaste permanente; o navegador não determina a causa.',action:'Volte ao uso normal, siga orientações do fabricante e reavalie mais tarde.'}
]:[
 {appearance:'Dark spot on a bright background',meaning:'Could involve a pixel that is not emitting expected light, but dust or surface marks may look similar.',action:'Clean the glass gently and compare red, green and blue backgrounds.'},
 {appearance:'Colored spot across several patterns',meaning:'Could involve a stuck subpixel. Appearance depends on panel technology.',action:'Record which colors reveal it; do not press or heat the display.'},
 {appearance:'Entire horizontal or vertical line',meaning:'A continuous line may involve the panel, connector, cable or signal rather than one pixel.',action:'Compare another input, cable or display if practical.'},
 {appearance:'Faint outline of previous content',meaning:'Could be temporary persistence or permanent aging; a browser cannot identify the cause.',action:'Resume normal varied content, follow manufacturer guidance and recheck later.'}
];
const docType=newPage?.mode==='guide'?'WebPage':'WebApplication';
const isCloudflarePreview = process.env.CF_PAGES === '1' && !!process.env.CF_PAGES_BRANCH && process.env.CF_PAGES_BRANCH !== 'main';
const publicSiteUrl=!isCloudflarePreview && import.meta.env.PUBLIC_SITE_URL ? new URL(import.meta.env.PUBLIC_SITE_URL).origin : undefined;
// Match schema with visible content. Do not invent reviews, lab measurements,
// FAQ-rich-result eligibility or timestamps that have not been recorded.
const schemaUrl=(path:string)=>publicSiteUrl?publicSiteUrl+(path==='/'?'/':path.replace(/\/+$/,'')):undefined;
const crumb=(name:string,path:string,position:number)=>({
 '@type':'ListItem',position,name,...(schemaUrl(path)?{item:schemaUrl(path)}:{})
});
const breadcrumbs=(items:{name:string;path:string}[])=>({
 '@type':'BreadcrumbList',
 itemListElement:items.map((item,i)=>crumb(item.name,item.path,i+1))
});
const breadcrumbItems=newPage
 ? [{name:isBR?'Teste de Pixel Morto':'Dead Pixel Test',path:isBR?'/pt-br/':'/'},
    {name:newPage.h1,path:newPage.path}]
 : article
 ? [{name:'Dead Pixel Test',path:'/'},{name:'Screen Testing Guides',path:'/blog'},
    {name:article.title,path:'/blog/'+article.slug}]
 : [{name:'Dead Pixel Test',path:'/'},{name:'Screen Testing Guides',path:'/blog'}];
const structuredData=newPage?{
 '@context':'https://schema.org',
 '@graph':[
  {'@type':docType,name:newPage.h1,
   ...(schemaUrl(newPage.path)?{url:schemaUrl(newPage.path)}:{}),
   description:newPage.description,
   inLanguage:newPage.lang,
   ...(docType==='WebApplication'?{applicationCategory:'UtilitiesApplication',operatingSystem:'Web Browser',
    offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}}:{})},
  // Do not give the pt-BR homepage a self-only breadcrumb.
  ...(normalized==='/pt-br'?[]:[breadcrumbs(breadcrumbItems)])
 ]
}:article?{
 '@context':'https://schema.org',
 '@graph':[
  {'@type':'BlogPosting',
   headline:article.title,description:article.excerpt,
   ...(schemaUrl('/blog/'+article.slug)?{mainEntityOfPage:schemaUrl('/blog/'+article.slug)}:{}),
   author:{'@type':'Organization',name:'DeadPixelTest',
    ...(schemaUrl('/about')?{url:schemaUrl('/about')}:{})},
   publisher:{'@type':'Organization',name:'DeadPixelTest'},
   ...(Number.isFinite(Date.parse(article.date))?{datePublished:new Date(article.date).toISOString().slice(0,10)}:{})
  },
  breadcrumbs(breadcrumbItems)
 ]
}:blogIndex?{
 '@context':'https://schema.org',
 '@graph':[
  {'@type':'CollectionPage',name:'Screen Testing Guides',
   ...(schemaUrl('/blog')?{url:schemaUrl('/blog')}:{})},
  breadcrumbs(breadcrumbItems)
 ]
}:infoPage?{
 '@context':'https://schema.org',
 '@type':normalized==='/about'?'AboutPage':normalized==='/contact'?'ContactPage':'WebPage',
 name:title,description,
 ...(schemaUrl(normalized)?{url:schemaUrl(normalized)}:{})
}:undefined;
const legacyGuides: Record<string,{heading:string;intro:string;steps:string[];limits:string[]}> = {
 ...legacySeoGuides,
 '/tests/refresh-rate':{
  heading:'How to interpret a frame-skipping and browser FPS check',
  intro:'This tool animates a repeating sequence of blocks using requestAnimationFrame. The on-screen FPS counter measures how frequently the browser callback fires; it does not directly read your monitor panel’s scan-out or verify its configured refresh rate.',
  steps:[
   'Open the test on the monitor you want to investigate. Check the refresh-rate setting in your operating system first.',
   'Let the browser FPS estimate settle for several seconds, without assuming that the value proves physical display Hz.',
   'For a frame-skipping investigation, use a separate camera with manual shutter settings and repeat photographs of the moving block.',
   'If you see irregular spacing, repeat with browser extensions disabled and other applications closed. Compare a different cable or port if relevant.'
  ],
  limits:[
   'Browser animation cadence may be limited by background tabs, battery saving, compositing, variable refresh rate and operating-system scheduling.',
   'A photo with gaps is a reason to investigate, not a conclusive hardware failure or warranty diagnosis.',
   'A browser cannot certify an overclocked panel’s actual refresh Hz.'
  ]
 },
 '/tests/local-dimming':{
  heading:'How to inspect local dimming, halos and blooming',
  intro:'A display with local dimming may brighten or darken groups of backlight zones around a high-contrast object. The pattern tool makes these effects easier to observe on a dark background; it does not measure zone count or peak luminance.',
  steps:[
   'Choose a comfortable brightness in a dim room and confirm whether the monitor’s local-dimming feature is enabled.',
   'Start with one bright box or circle against black. Move it slowly and observe any soft halo or abrupt brightness changes nearby.',
   'Compare shapes and sizes, then repeat with local dimming disabled if your display offers that setting.',
   'Make notes about the conditions. Automatic brightness, HDR processing and viewing angle can change the apparent result.'
  ],
  limits:[
   'Different Mini-LED and OLED technologies respond differently; a halo does not automatically indicate a defective panel.',
   'The browser does not know the number or hardware behavior of dimming zones.',
   'Avoid leaving high-brightness static patterns on an OLED panel for extended periods.'
  ]
 },
 '/tests/color-gradient':{
  heading:'How to identify visible color banding',
  intro:'Smooth gradients can reveal abrupt steps between tones that would ideally appear continuous. Use gray and primary-color ramps to observe posterization, but distinguish browser rendering from calibrated panel color performance.',
  steps:[
   'Display a neutral grayscale gradient and inspect for noticeable bands or colored tints under normal room lighting.',
   'Compare red, green and blue gradients and switch between horizontal and vertical directions.',
   'Check HDR mode, display color profile, browser color management and graphics driver settings if the result differs between applications.',
   'Do not confuse intentional hard-step test patterns with artifacts in the smooth-gradient mode.'
  ],
  limits:[
   'Screenshots capture rendered pixels, not the actual light emitted by the panel.',
   'Operating-system bit depth, dithering, color profile and compression can introduce visible steps.',
   'A browser page is not a substitute for a colorimeter or professional calibration.'
  ]
 },
 '/tests/audio-sync':{
  heading:'How to check perceived audio and video timing',
  intro:'The interactive test produces a visible event and an audio cue. You can adjust an apparent offset while listening, but your own reaction time and device latency prevent it from being a calibrated end-to-end synchronization measurement.',
  steps:[
   'Start with the speakers or headphones and display that you actually use.',
   'Observe the visual cue alongside the audible click several times at a comfortable volume.',
   'Adjust the offset only after repeated observations. Compare wired and wireless audio if both are available.',
   'For objective measurement, record the screen and sound using equipment with a shared timing reference.'
  ],
  limits:[
   'Bluetooth codecs, output buffering, browser scheduling and operating-system mixers can all change apparent latency.',
   'A manually selected offset is subjective; it is not a certified latency measurement.',
   'Keep the volume comfortable and stop if the repeating cues cause discomfort.'
  ]
 },
 '/tests/test-patterns':{
  heading:'Using display patterns for visual checks',
  intro:'Color bars, grids, ramps and sharpness patterns can help you examine alignment and visible processing effects. These are browser-drawn reference patterns, not calibrated broadcast signals or panel manufacturing tests.',
  steps:[
   'Confirm that browser zoom and display scaling are set to known values.',
   'Use grid and sharpness patterns to look for visible unevenness or scaling artifacts.',
   'Compare ramps and color bars without assuming the displayed colors are spectrally or luminance calibrated.',
   'Change only one display setting at a time and record what visibly changes.'
  ],
  limits:[
   'CSS pixels can cover more or fewer than one physical panel pixel depending on DPR, scaling and browser zoom.',
   'HDR and color-management transforms can change color appearance.',
   'Browser patterns alone cannot certify a screen’s accuracy or identify which hardware component has failed.'
  ]
 }
};
const specificGuidance: Record<string,{heading:string;intro:string;checks:{title:string;body:string}[]}> = {
 '/laptop-screen-dead-pixel-test':{
  heading:'Laptop-specific troubleshooting before requesting repair',
  intro:'The internal laptop panel, a connected external monitor and the graphics path can behave differently. Record which display actually shows the suspected defect before making a warranty request.',
  checks:[
   {title:'Internal panel versus external monitor',body:'Move the test to each physical display in turn. A clean external image and an abnormal laptop panel narrow the investigation, but do not by themselves identify the failed part.'},
   {title:'Before Windows or macOS loads',body:'If your laptop provides a safe manufacturer boot logo, diagnostics screen or firmware display, note whether the same line or spot appears there. Avoid changing firmware settings or opening the case.'},
   {title:'Angle and power changes',body:'If a line changes with lid angle, charging or brightness, record those conditions without forcing the hinge. This is supporting information for service, not proof of a cable fault.'},
   {title:'Document for support',body:'Record the background colors that reveal the spot and whether it appears on the built-in display only. Review the manufacturer’s individual pixel-defect and return policy.'}
  ]
 },
 '/pt-br/pixel-morto-notebook':{
  heading:'Como comparar a tela interna do notebook com outra tela',
  intro:'Um ponto anormal na tela do notebook pode ter causas distintas. Faça a comparação no próprio aparelho e, se possível, em outro monitor, sem desmontar o equipamento.',
  checks:[
   {title:'Tela interna e monitor externo',body:'Mova a janela do teste para cada tela. O comportamento diferente ajuda na investigação, mas não determina sozinho qual componente falhou.'},
   {title:'Imagem antes do sistema iniciar',body:'Se houver uma tela de inicialização ou diagnóstico do fabricante que você consiga visualizar sem mudar configurações, veja se a anomalia também aparece nela.'},
   {title:'Ângulo da tampa e brilho',body:'Anote se uma linha muda com a posição normal da tampa ou o brilho, sem forçar a dobradiça. Não pressione o painel.'},
   {title:'Informações para a assistência',body:'Registre em quais cores o ponto aparece e consulte a política de pixels defeituosos e garantia do fabricante.'}
  ]
 },
 '/phone-screen-dead-pixel-test':{
  heading:'Phone-screen checks that are different from a monitor test',
  intro:'Touch, screen protectors, browser fullscreen restrictions and adaptive display features can all affect the way a suspicious spot looks on a phone.',
  checks:[
   {title:'Glass, protector and camera cutout',body:'Check the same location with the screen off. Dust, a bubble under a protector or a front-camera cutout can be mistaken for a bad pixel.'},
   {title:'iPhone Safari fullscreen fallback',body:'On iPhones, native fullscreen support depends on the browser and device. The test stays usable in an overlay, with a clearly visible Exit button.'},
   {title:'Rotation and screen controls',body:'Repeat the static fields in portrait and landscape as needed. Use the on-screen buttons or horizontal swipes; avoid pressing the panel.'},
   {title:'Why screenshots may look normal',body:'A screenshot records rendered image data. Defects confined to the physical panel can be invisible in a screenshot. Describe your observation to the seller instead.'}
  ]
 },
 '/pt-br/pixel-morto-iphone':{
  heading:'Verificações específicas para iPhone e celular',
  intro:'No celular, película, recorte da câmera, brilho automático e limitações do navegador precisam ser considerados antes de concluir que existe um pixel defeituoso.',
  checks:[
   {title:'Vidro e película',body:'Confira se o mesmo ponto aparece com a tela apagada. Uma bolha, poeira ou recorte da câmera pode parecer um defeito.'},
   {title:'Safari e tela cheia',body:'Quando o Safari não permite tela cheia nativa, o teste continua em uma sobreposição com botão de saída sempre disponível.'},
   {title:'Orientação e brilho',body:'Compare as cores estáticas nas orientações vertical e horizontal, com brilho confortável. Não pressione a tela.'},
   {title:'Captura de tela não é laudo',body:'Uma captura digital normalmente não registra falhas que ocorrem apenas na camada física do painel. Anote o comportamento para a assistência.'}
  ]
 },
 '/dead-pixel-line-test':{
  heading:'What to check when an entire row or column looks abnormal',
  intro:'A continuous line requires a different approach from one isolated dot. Use the line patterns to describe the symptom and then compare alternative signals.',
  checks:[
   {title:'Solid backgrounds',body:'If the line remains at exactly the same position on black, white and RGB fields, record that. Some signal errors may appear only with particular tones or motion.'},
   {title:'Change input source',body:'On a monitor, compare another cable or input if available. On a laptop, compare a separate external display. Avoid opening the housing.'},
   {title:'System-level display',body:'If visible and safe, check whether the symptom is present in the manufacturer boot logo or a built-in diagnostics screen, not only in one application.'},
   {title:'When to contact a professional',body:'Persistent lines, rapidly spreading artifacts or flickering should be reviewed by the manufacturer or a qualified repair provider. This webpage does not identify a panel or cable fault.'}
  ]
 },
 '/image-retention-test':{
  heading:'Temporary retention and permanent OLED burn-in are not interchangeable',
  intro:'Residual outlines can come from several display behaviors. This neutral-gray check records what you see at the moment, not the rate of wear or whether the issue is reversible.',
  checks:[
   {title:'Before the check',body:'Close or change the previously static application. Use comfortable brightness; do not intentionally leave static bright content displayed just to create a mark.'},
   {title:'Neutral gray first',body:'Look for faint outlines on a neutral gray screen, then briefly compare near-black, near-white and plain primary colors.'},
   {title:'Recheck under similar conditions',body:'Return to varied normal content and recheck later. Note brightness, temperature and HDR settings so the observations can be compared.'},
   {title:'Interpreting persistence',body:'Temporary persistence may fade. Permanent OLED burn-in involves uneven aging. A browser cannot definitively distinguish either or reverse hardware aging.'}
  ]
 },
 '/screen-contrast-test':{
  heading:'Read the 14 contrast and color patterns',
  intro:'Use each pattern for the purpose it was designed for. These are browser-generated visuals rather than calibrated light measurements.',
  checks:[
   {title:'Black and white levels',body:'Near-black and near-white steps show whether nearby shades remain visually distinguishable. Crushing or clipping may also depend on display settings.'},
   {title:'Smooth RGB gradients',body:'Red, green and blue ramps help reveal visible banding and abrupt transitions; the browser does not measure sRGB or DCI-P3 coverage.'},
   {title:'Seven color bars',body:'Compare basic color presentation and obvious tint differences. Correct-looking bars do not establish color accuracy.'},
   {title:'Record the environment',body:'Viewing angle, room lighting, HDR, display profiles and operating-system color settings may alter the result. A colorimeter is required for quantitative calibration.'}
  ]
 },
 '/pt-br/teste-de-cores':{
  heading:'Como interpretar os 14 padrões de cores e contraste',
  intro:'Os padrões são desenhados pelo navegador para comparação visual. Eles não medem brilho em nits, relação de contraste ou espaço de cor do painel.',
  checks:[
   {title:'Níveis próximos de preto e branco',body:'As faixas mostram se você consegue diferenciar tons muito escuros ou muito claros; brilho e HDR também alteram a aparência.'},
   {title:'Gradientes vermelho, verde e azul',body:'Observe transições que deveriam parecer suaves e registre faixas abruptas. O resultado não comprova cobertura de sRGB ou DCI-P3.'},
   {title:'Barras de cores',body:'Compare as cores principais e possíveis diferenças visíveis, sem considerar esta observação uma calibração de cor.'},
   {title:'Condições do teste',body:'Anote perfil de cores, luz do ambiente, ângulo da tela e configurações do sistema. Medições quantitativas exigem instrumentos.'}
  ]
 }
};

type SymptomOption={title:string;check:string;action:string;link?:string;linkLabel?:string};
const symptomDecisions:Record<string,{heading:string;intro:string;options:SymptomOption[];source:string}>={
 '/laptop-screen-dead-pixel-test':{
  heading:'Laptop screen symptoms: what to check next',
  intro:'Choose the symptom closest to what you see. These are follow-up suggestions, not an automated diagnosis.',
  source:'Manufacturer example: Dell pixel guidance',
  options:[
   {title:'Single dark point on white',check:'Clean the glass, then compare the same position on white, red, green and blue.',action:'Mark its approximate position in the test report and check your model’s pixel-defect/return policy.'},
   {title:'Bright or colored point on black',check:'Compare the spot on black and the three primary colors. Note which backgrounds reveal it.',action:'Record the behavior without pressing or heating the screen. Contact the manufacturer for policy-specific advice.'},
   {title:'Complete horizontal or vertical line',check:'Compare the line across solid colors; where practical, check an external display or different cable.',action:'A continuous line differs from one isolated pixel. Follow the dedicated line comparison.',link:'/dead-pixel-line-test',linkLabel:'Screen-line test'},
   {title:'Issue on the internal panel only',check:'Move this browser test to the laptop panel and external monitor separately and compare.',action:'Record which display shows the issue; this comparison does not prove which component is faulty.'}
  ]},
 '/pt-br/pixel-morto-notebook':{
  heading:'Pixel morto no notebook: como interpretar o sintoma',
  intro:'Escolha o caso que se parece com sua tela. Estas etapas orientam a observação, sem emitir laudo técnico.',
  source:'Exemplo do fabricante: orientação da Dell (em português)',
  options:[
   {title:'Ponto escuro no fundo branco',check:'Limpe o vidro com cuidado e compare o mesmo ponto nas cores branco, vermelho, verde e azul.',action:'Marque o local aproximado, exporte o registro e consulte a política de troca do fabricante.'},
   {title:'Ponto brilhante ou colorido no preto',check:'Observe o ponto no fundo preto e depois em cada cor primária.',action:'Anote em quais cores ele aparece. Não pressione nem aqueça a tela.'},
   {title:'Linha horizontal ou vertical inteira',check:'Compare várias cores e, se possível, um monitor externo ou outra entrada.',action:'Uma linha contínua não é igual a um pixel isolado. Registre o sintoma e procure assistência.'},
   {title:'Problema somente na tela interna',check:'Compare a tela integrada e outra tela usando a mesma ferramenta.',action:'A diferença ajuda na triagem, mas não prova defeito de painel, cabo ou GPU.'}
  ]},
 '/dead-pixel-fixer':{
  heading:'Does this symptom need a pixel fixer?',
  intro:'Online color patterns can help document a spot, but they cannot repair physical panel damage.',
  source:'Manufacturer safety reference: Dell pixel guidance',
  options:[
   {title:'Always-dark point in several colors',check:'Clean the surface, compare white and primary-color patterns, and note the same screen position.',action:'Physical dead pixels cannot be fixed by a webpage. Save your observations and contact support.'},
   {title:'Point stays red, green or blue',check:'Use the movable static patch to compare colors without rapid flashes.',action:'Record which colors show the point. Avoid heat, pressure and rapid flashing; no fix is guaranteed.'},
   {title:'Faint outline from an old window',check:'Briefly check neutral gray and note whether the outline changes after normal varied content.',action:'This may be image retention rather than an isolated pixel defect.',link:'/image-retention-test',linkLabel:'Image retention check'},
   {title:'A full row or column is abnormal',check:'Compare multiple static colors and check whether the line stays in place.',action:'A full-line issue requires broader troubleshooting, not pixel-fixer software.',link:'/dead-pixel-line-test',linkLabel:'Screen-line troubleshooting'}
  ]},
 '/pt-br/reparar-pixel-preso':{
  heading:'Pixel preso: qual próximo passo é seguro?',
  intro:'Um teste com cores estáticas serve para observar, não para consertar o painel.',
  source:'Referência de segurança: Dell (em português)',
  options:[
   {title:'Ponto sempre escuro em várias cores',check:'Limpe o vidro e observe a mesma região nos fundos branco e RGB.',action:'Uma página não recupera um pixel fisicamente danificado. Guarde o registro para a assistência.'},
   {title:'Ponto sempre vermelho, verde ou azul',check:'Compare cores estáticas e use a área móvel como referência, sem piscar rapidamente.',action:'Registre quais cores mostram a anomalia. Evite pressão e calor; nenhuma correção é garantida.'},
   {title:'Sombra de uma imagem anterior',check:'Observe brevemente o cinza neutro e retome o conteúdo normal.',action:'Pode ser persistência de imagem; siga as orientações de cuidado do fabricante.'},
   {title:'Linha contínua na tela',check:'Compare a linha em vários fundos e, se possível, em outra tela.',action:'Uma linha inteira exige análise de tela/sinal e não será corrigida por um reparador de pixels online.'}
  ]}
};
const symptomDecision=symptomDecisions[normalized];

const taskGuide=specificGuidance[normalized];
const legacyGuide=legacyGuides[normalized];
const canonicalPath=normalized==='/tests/dead-pixel'?'/':newPage?.path||route;
---
<BaseLayout title={title} description={description} canonicalPath={canonicalPath} lang={locale} legacy={isLegacy} noindex={Boolean((newPage && !newPage.indexable) || normalized==='/tests/dead-pixel')} schema={structuredData}>
{newPage ? (
  <main id="main-content" tabindex="-1" class="ui-site-main max-w-6xl mx-auto px-4 pt-7 md:px-8 md:pt-10">
    <nav aria-label="Breadcrumb" class="ui-breadcrumb mb-7"><a href={isBR?'/pt-br':'/'}>{isBR?'Início':'Home'}</a><span aria-hidden="true">/</span><span aria-current="page">{newPage.h1}</span></nav>
    <header class="ui-landing-hero ui-enter rounded-2xl border border-[#DCE3EA] bg-white shadow-sm p-6 md:p-10">
      <p class="ui-eyebrow uppercase tracking-widest text-xs text-[#125CC9] font-bold"><span class="ui-status-dot" aria-hidden="true"></span>{isBR?'Ferramenta online gratuita':'Free browser-based screen check'}</p>
       <div class="ui-swatch-track ui-swatch-track-sm" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
      <h1 class="text-3xl md:text-5xl font-bold mt-3 tracking-tight">{newPage.h1}</h1>
      <p class="text-[#344256] max-w-3xl text-lg leading-8 mt-5 mb-7">{newPage.lead}</p>
      {newPage.mode==='resolution' ? (
         <div class="ui-screen-metrics-grid grid md:grid-cols-2 gap-4">
           <div class="ui-metrics-panel border border-[#DCE3EA] bg-white p-5 rounded-lg"><h2 class="font-semibold mb-2">CSS screen and viewport</h2><p class="text-[#344256]">The values below are reported by the browser, not by the display panel’s hardware specifications.</p></div>
           <div class="ui-metrics-panel border border-[#DCE3EA] bg-white p-5 rounded-lg">
             <dl id="screen-metrics" aria-live="off" class="font-mono text-sm text-[#344256]">Enable JavaScript for live screen and viewport metrics.</dl>
             <button id="copy-screen-metrics" type="button" class="mt-3 min-h-[44px] rounded-lg bg-[#31583F] px-4 py-2 text-sm font-semibold text-white hover:bg-[#244631]">Copy browser metrics</button>
             <p id="copy-screen-status" role="status" class="mt-2 text-xs text-[#475569]" aria-live="polite"></p>
           </div>
           <div class="ui-metrics-panel md:col-span-2 rounded-xl border border-[#C7DCC6] bg-white p-5">
             <h2 class="text-xl font-semibold mb-2">Optional PPI calculator — user-confirmed panel resolution</h2>
             <p class="text-sm leading-6 text-[#344256]">Use the display's stated <strong>native physical pixel resolution</strong> and measured diagonal size, not the browser-reported CSS width or height above. No value is filled in automatically.</p>
             <form id="manual-ppi" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" novalidate>
               <label class="block text-sm text-[#101827]">Native width (physical pixels)
                 <input id="native-width" inputmode="numeric" type="number" min="1" max="20000" step="1" placeholder="e.g. 1920" class="mt-2 w-full rounded-lg border border-[#CBD5E1] bg-white px-3 py-3 text-[#101827]" />
               </label>
               <label class="block text-sm text-[#101827]">Native height (physical pixels)
                 <input id="native-height" inputmode="numeric" type="number" min="1" max="20000" step="1" placeholder="e.g. 1080" class="mt-2 w-full rounded-lg border border-[#CBD5E1] bg-white px-3 py-3 text-[#101827]" />
               </label>
               <label class="block text-sm text-[#101827]">Screen diagonal (inches)
                 <input id="native-diagonal" inputmode="decimal" type="number" min="0.1" max="300" step="any" placeholder="e.g. 24" class="mt-2 w-full rounded-lg border border-[#CBD5E1] bg-white px-3 py-3 text-[#101827]" />
               </label>
               <div class="flex flex-col justify-end">
                 <button type="submit" class="min-h-[48px] rounded-lg bg-[#31583F] px-4 py-3 font-semibold text-white hover:bg-[#244631]">Calculate PPI</button>
               </div>
               <label class="sm:col-span-2 lg:col-span-4 flex items-start gap-3 text-sm text-[#101827]">
                 <input id="native-confirmed" type="checkbox" class="mt-1 h-4 w-4 shrink-0" />
                 I checked the native physical resolution in my display specifications or system settings.
               </label>
             </form>
             <p id="ppi-result" role="status" aria-live="polite" class="mt-4 text-sm font-semibold text-[#28513B]">Enter values and confirm they describe your display's physical pixel resolution.</p>
             <p class="mt-2 text-xs text-[#475569]">PPI = √(width² + height²) ÷ diagonal inches. This is a calculated estimate from user-supplied specifications, not a measurement of the panel.</p>
           </div>
         </div>
       ) : (
         <div class="ui-inspection-shell p-5 rounded-xl border border-[#20283C] bg-[#0A0B0E] text-white">
           <ScreenInspection client:only="react" mode={inspectionMode} lang={newPage.lang}
             defaultDevice={/laptop|notebook/.test(normalized)?'laptop':/phone|iphone/.test(normalized)?'phone':'monitor'} />
           <noscript>
             <div role="note" class="mt-4 rounded-lg border border-amber-400/40 bg-neutral-900 p-4 text-sm text-white">
               <strong>{isBR?'JavaScript está desativado.':'JavaScript is disabled.'}</strong>
               <p class="mt-2 leading-6">{isBR
                 ? 'A inspeção em tela cheia, a marcação de pontos e o relatório precisam de JavaScript. Ative-o e recarregue esta página. Nenhuma conta é necessária.'
                 : 'The full-screen inspection, mark recording and downloadable report need JavaScript. Enable it and reload this page. No account is required.'}</p>
             </div>
           </noscript>
         </div>
       )}
       <p class="mt-5 text-xs text-[#64748B]">{isBR?'Inspeção manual. Sem certificação.':'Manual visual self-check. Not an automated hardware diagnosis or certificate.'}</p>
    </header>
    {geoAnswer && <section id="quick-answer" data-geo-answer class="mt-7 rounded-xl border border-[#DCE3EA] bg-white px-5 py-6 text-[#101827] md:px-8" aria-labelledby="quick-answer-heading">
      <p class="text-xs font-bold uppercase tracking-wider text-[#31583F]">{isBR?'RESPOSTA DIRETA':'IN BRIEF / DIRECT ANSWER'}</p>
      <h2 id="quick-answer-heading" class="mt-2 text-2xl font-bold">{geoAnswer.question}</h2>
      <p class="mt-4 max-w-4xl text-base leading-8 text-[#344256]">{geoAnswer.answer}</p>
      <h3 class="mt-5 text-base font-semibold">{isBR?'O que verificar':'Practical checks'}</h3>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-7 text-[#344256]">
        {geoAnswer.distinctions.map(item=><li>{item}</li>)}
      </ul>
      <p class="mt-5 border-t border-[#DCE3EA] pt-4 text-sm leading-7 text-[#344256]"><strong>{isBR?'Limite da ferramenta':'What this cannot prove'}:</strong> {geoAnswer.limitation}</p>
      {geoAnswer.sources.length>0 && <p class="mt-3 text-xs leading-6 text-[#475569]">
        {isBR?'Referências técnicas externas: ':'Technical references: '}
        {geoAnswer.sources.map((source,i)=><>
          {i>0 && <span aria-hidden="true"> · </span>}
          <a class="text-[#125CC9] underline underline-offset-2" href={source.url} target="_blank" rel="noopener noreferrer">{source.name}</a>
        </>)}
      </p>}
    </section>}
    <section class="ui-procedure ui-section mt-12 grid md:grid-cols-[2fr_1fr] gap-6 lg:gap-10" aria-label={isBR?"Instruções do teste":"Test instructions"}>
      <div>
        <p class="ui-overline">{isBR?'PROCEDIMENTO / PASSO A PASSO':'PROCEDURE / STEP BY STEP'}</p><h2 class="text-2xl font-bold mb-5">{isBR?'Como fazer o teste':'How to run this check'}</h2>
        <ol class="ui-numbered-steps space-y-4">{newPage.steps.map((step,i)=><li class="flex items-start gap-4 text-[#344256] leading-7"><span class="ui-step-number">{i+1}</span><span>{step}</span></li>)}</ol>
      </div>
      <aside class="ui-guide-aside ui-help-card border border-[#DCE3EA] bg-white rounded-xl p-5">
        <h2 class="text-lg font-bold mb-3">{isBR?'Antes de começar':'Before you start'}</h2>
        <p class="text-[#344256] leading-7">{isBR?'Limpe a tela, evite reflexos e confira filtros de luz azul ou HDR.':'Clean the screen, reduce reflections, and note HDR, zoom and adaptive brightness settings.'}</p>
      </aside>
    </section>
    {taskGuide && <section class="mt-12">
      <h2 class="text-2xl font-bold mb-3">{taskGuide.heading}</h2>
      <p class="max-w-3xl text-[#344256] leading-7 mb-6">{taskGuide.intro}</p>
      <div class="grid gap-4 md:grid-cols-2">{taskGuide.checks.map(check=><article class="ui-info-card rounded-xl border border-[#DCE3EA] bg-white shadow-sm p-5">
        <h3 class="text-lg font-semibold text-[#101827]">{check.title}</h3>
        <p class="mt-3 leading-7 text-[#344256]">{check.body}</p>
      </article>)}</div>
    </section>}

    {symptomDecision && <section class="mt-12" data-symptom-decision>
      <h2 class="text-2xl font-bold mb-3">{symptomDecision.heading}</h2>
      <p class="max-w-3xl mb-5 leading-7 text-[#344256]">{symptomDecision.intro}</p>
      <div class="grid gap-3 md:grid-cols-2">
        {symptomDecision.options.map(option=><details class="ui-disclosure rounded-xl border border-[#DCE3EA] bg-white p-5">
          <summary class="cursor-pointer font-semibold text-[#101827]">{option.title}</summary>
          <div class="mt-4 border-t border-[#DCE3EA] pt-4 text-sm leading-7 text-[#344256]">
            <p><strong>{isBR?'Verificação':'Check'}:</strong> {option.check}</p>
            <p class="mt-3"><strong>{isBR?'Próximo passo':'Next step'}:</strong> {option.action}</p>
            {option.link && <a class="mt-3 inline-block font-semibold text-[#125CC9] underline underline-offset-4" href={option.link}>{option.linkLabel}</a>}
          </div>
        </details>)}
      </div>
      <p class="mt-4 text-sm leading-7 text-[#344256]">{isBR?'Regras de troca variam por fabricante e modelo.':'Return policies vary by manufacturer and model.'} <a href={isBR?'https://www.dell.com/support/kbdoc/pt-br/000126004/diretrizes-de-pixels-da-tela-dell':'https://www.dell.com/support/kbdoc/en-us/000126004/dell-display-pixel-guidelines'} target="_blank" rel="noopener noreferrer" class="font-semibold text-[#125CC9] underline underline-offset-4">{symptomDecision.source}</a>.</p>
    </section>}
    {normalized==='/image-retention-test' && <section class="mt-12 rounded-xl border border-[#DCE3EA] bg-white p-6" aria-label="Manufacturer OLED care resources">
      <h2 class="text-2xl font-bold text-[#101827]">Manufacturer OLED panel-care guides</h2>
      <p class="mt-3 max-w-3xl leading-7 text-[#344256]">Built-in Pixel Refresh and Image Cleaning are device-specific maintenance functions, not features of this website. Check your model's manual before using them. The visual patterns above cannot repair image retention, determine permanent burn-in, or replace warranty service.</p>
      <div class="mt-5 grid gap-3 md:grid-cols-2">
        <a class="rounded-lg border border-[#DCE3EA] px-4 py-4 font-semibold text-[#125CC9] underline underline-offset-4" href="https://www.samsung.com/sg/support/displays/how-to-troubleshoot-burnin-or-image-retention-on-your-samsung-oled-monitor/" target="_blank" rel="noopener noreferrer">Samsung OLED monitor — Panel Care and Pixel Refresh</a>
        <a class="rounded-lg border border-[#DCE3EA] px-4 py-4 font-semibold text-[#125CC9] underline underline-offset-4" href="https://www.lg.com/us/support/help-library/lg-tv-troubleshooting-image-burnin--20152745607830" target="_blank" rel="noopener noreferrer">LG OLED TV — image retention and Pixel Cleaning</a>
      </div>
      <p class="mt-4 text-sm leading-6 text-[#475569]">Model and firmware menus differ. Avoid leaving static patterns on an OLED for prolonged periods; if marks persist, contact the manufacturer.</p>
    </section>}
    <section class="ui-content-section mt-12"><p class="ui-overline">{isBR?'SEGURANÇA / INFORMAÇÃO IMPORTANTE':'SAFETY / IMPORTANT INFORMATION'}</p><h2 class="text-2xl font-bold mb-5">{isBR?'Limitações e segurança':'Limitations and safety'}</h2>
      <div class="grid md:grid-cols-2 gap-4">{newPage.notes.map(note=><p class="ui-safety-note ui-info-card border border-[#DCE3EA] bg-white p-5 rounded-xl text-[#344256] leading-7">{note}</p>)}</div>
    </section>
    {newPage.mode==='guide' && <section class="mt-12">
      <h2 class="text-2xl font-bold mb-4">{isBR?'Compare o que você observa':'Compare what you see'}</h2>
      <p class="max-w-3xl text-[#344256] leading-7 mb-5">{isBR?'Os exemplos abaixo ajudam a escolher o próximo passo. Eles não identificam o defeito automaticamente.':'These examples guide your next visual check; they do not automatically diagnose your display.'}</p>
      <div class="grid gap-4 md:grid-cols-2">
        {pixelDifferences.map(item=><article class="ui-info-card rounded-xl border border-[#DCE3EA] bg-white p-5">
          <h3 class="text-lg font-semibold text-[#101827]">{item.appearance}</h3>
          <p class="mt-3 text-sm leading-7 text-[#344256]">{item.meaning}</p>
          <p class="mt-3 border-t border-[#DCE3EA] pt-3 text-sm leading-7 text-[#125CC9]"><strong>{isBR?'Próximo passo':'Next step'}:</strong> {item.action}</p>
        </article>)}
      </div>
    </section>}
    {newPage.mode==='fixer' && <section class="mt-12 rounded-xl border border-[#C7DCC6] bg-[#EDF5E9] p-5 md:p-7">
      <h2 class="text-2xl font-bold mb-3">{isBR?'Como usar a área de cor estática':'How to use the static color patch'}</h2>
      <p class="leading-7 text-[#344256]">{isBR?'Abra o teste, toque na região suspeita para posicionar a área estática, escolha a cor e ajuste o tamanho. A comparação é manual, sem flashes rápidos e sem promessa de reparo.':'Start the test, click or tap the suspicious area to position the static patch, choose a patch color and adjust its size. This is a manual comparison, not rapid flashing or a guaranteed repair.'}</p>
    </section>}
    <section class="ui-content-section mt-12"><p class="ui-overline">{isBR?'RESPOSTAS / DÚVIDAS FREQUENTES':'HELP / FREQUENT QUESTIONS'}</p><h2 class="text-2xl font-bold mb-5">{isBR?'Perguntas frequentes':'Frequently asked questions'}</h2>
      <div class="ui-faq-list space-y-4">{newPage.faq.map(item=><article class="ui-info-card rounded-xl border border-[#DCE3EA] bg-white p-5"><h3 class="font-semibold text-lg">{item.question}</h3><p class="text-[#344256] leading-7 mt-3">{item.answer}</p></article>)}</div>
    </section>
    <nav class="ui-topic-language mt-10 flex flex-wrap items-center gap-3 border-t border-[#DCE3EA] pt-6 text-sm" aria-label={isBR?'Mudar idioma':'Switch language'}>
      <span class="text-[#475569]">{isBR?'Outros idiomas:':'Other language:'}</span>
      <a href={switchLocaleHref} hreflang={isBR?'en':'pt-BR'} class="ui-locale-action min-h-[44px] rounded-lg border border-[#DCE3EA] px-4 py-3">{isBR?(localePair?'English':'English (home page)'):(localePair?'Português (Brasil)':'Português (página inicial)')}</a>
    </nav>
    <section class="ui-content-section mt-12" aria-label={isBR?'Testes relacionados':'Related tests'}>
      <p class="ui-overline">{isBR?'PRÓXIMO / OUTRAS FERRAMENTAS':'NEXT / OTHER TOOLS'}</p>
      <h2 class="text-2xl font-bold mb-5">{isBR?'Testes relacionados':'Related tests'}</h2>
      <div class="ui-related-links grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {others.map(other=><a class="ui-related-link" href={other.path.replace(/\/$/,'')}>
          <span class="ui-related-link-title">{other.h1}</span><span class="ui-related-link-arrow" aria-hidden="true">↗</span>
        </a>)}
      </div>
    </section>
  </main>
) : article ? (
  <main id="main-content" tabindex="-1" class="max-w-4xl mx-auto px-5 pt-12">
    <nav aria-label="Breadcrumb"><a href="/blog" class="text-[#125CC9]">← All guides</a></nav>
    <article class="prose max-w-none py-8">
      <p class="text-sm uppercase tracking-widest text-[#125CC9]">{article.category} · <time datetime={new Date(article.date).toISOString().slice(0,10)}>{article.date}</time> · By <a href="/about">DeadPixelTest</a></p>
      <h1 class="text-4xl font-bold">{article.title}</h1>
      <p class="text-[#475569] leading-8">{article.excerpt}</p>
      <div class="mt-8 blog-article" set:html={article.content} />
    </article>
    <a href="/" class="inline-block text-[#125CC9] mt-5">Open the dead pixel test →</a>
  </main>
) : blogIndex ? (
  <main id="main-content" tabindex="-1" class="max-w-6xl mx-auto px-5 py-12">
    <h1 class="text-4xl font-bold mb-4">Screen Testing Guides</h1><p class="text-[#475569] mb-8">Practical explanations and display troubleshooting articles.</p>
    <div class="grid md:grid-cols-2 gap-5">{BLOG_POSTS.map(post=><a href={'/blog/'+post.slug} class="border border-[#DCE3EA] rounded-xl p-5 hover:border-blue-500/60">
      <h2 class="text-xl font-bold mb-2">{post.title}</h2><p class="text-[#475569]">{post.excerpt}</p></a>)}</div>
  </main>
) : infoPage ? (
  <SiteInformation route={normalized as '/about' | '/contact' | '/privacy-policy' | '/terms-of-service'} />
) : (
  <>
    <App client:only="react" />
    <section id="legacy-static-guide" class="mx-auto my-10 max-w-5xl rounded-2xl border border-[#DCE3EA] bg-white px-6 py-8 text-[#344256] leading-7 shadow-sm md:px-10 md:py-10" aria-label="Display test information">
      {legacyGuide ? (
        <>
          <h2 class="text-2xl font-semibold text-[#101827] mb-4">{legacyGuide.heading}</h2>
          <p class="max-w-3xl">{legacyGuide.intro}</p>
          <div class="mt-8 grid gap-8 md:grid-cols-2">
            <div>
              <h3 class="text-lg font-semibold text-[#101827] mb-3">Practical inspection steps</h3>
              <ol class="list-decimal pl-5 space-y-3">{legacyGuide.steps.map(step=><li>{step}</li>)}</ol>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-[#101827] mb-3">What the result cannot prove</h3>
              <ul class="list-disc pl-5 space-y-3">{legacyGuide.limits.map(limit=><li>{limit}</li>)}</ul>
            </div>
          </div>
        </>
      ) : (
        <>
          <h2 class="text-xl font-semibold text-[#101827] mb-3">About {title}</h2>
          <p>{description}</p>
          <p class="mt-3">The interactive tool loads in your browser. This is a user-operated visual check, not a hardware certification. Browser and display settings affect results.</p>
        </>
      )}
      <nav aria-label="Related display tests" class="mt-8 flex flex-wrap gap-3">
        <a class="text-[#125CC9] hover:underline" href="/">Dead Pixel Test</a>
        <a class="text-[#125CC9] hover:underline" href="/tests/local-dimming">Local Dimming</a>
        <a class="text-[#125CC9] hover:underline" href="/tests/color-gradient">Color Gradient</a>
        <a class="text-[#125CC9] hover:underline" href="/tests/refresh-rate">Browser FPS</a>
      </nav>
    </section>
  </>
)}
{newPage?.mode==='resolution' && <script is:inline>
  (function() {
    const el=document.getElementById('screen-metrics');
    if(!el)return;
    const fmt=(value)=>Number.isFinite(value)?String(Math.round(value*100)/100):'Not reported';
    let metrics=[];
    const update=()=>{
      el.replaceChildren();
      const s=window.screen;
      const vv=window.visualViewport;
      const orientation=s.orientation?.type || (window.innerWidth>=window.innerHeight?'landscape':'portrait');
      const data=[
        ['Screen width (CSS px)',s.width],
        ['Screen height (CSS px)',s.height],
        ['Available screen width (CSS px)',s.availWidth],
        ['Available screen height (CSS px)',s.availHeight],
        ['Browser viewport width (CSS px)',window.innerWidth],
        ['Browser viewport height (CSS px)',window.innerHeight],
        ['Visual viewport width (CSS px)',vv?fmt(vv.width):'Not supported'],
        ['Visual viewport height (CSS px)',vv?fmt(vv.height):'Not supported'],
        ['Device pixel ratio (DPR)',fmt(window.devicePixelRatio)],
        ['Screen color depth (bits)',s.colorDepth],
        ['Screen pixel depth (bits)',s.pixelDepth],
        ['Orientation',orientation]
      ];
      metrics=data;
      for(const [name,value] of data){
        const dt=document.createElement('dt');dt.textContent=String(name);
        const dd=document.createElement('dd');dd.textContent=String(value);
        el.append(dt,dd);
      }
    };
    window.addEventListener('resize',update);
    window.addEventListener('orientationchange',update);
    window.visualViewport?.addEventListener('resize',update);
    document.getElementById('copy-screen-metrics')?.addEventListener('click',async()=>{
      const status=document.getElementById('copy-screen-status');
      const body=metrics.map(([name,value])=>name+': '+value).join('\n')+'\nBrowser-reported CSS metrics only; not native physical panel resolution.';
      try{
        if(!navigator.clipboard?.writeText)throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(body);
        if(status)status.textContent='Browser metrics copied.';
      }catch{
        if(status)status.textContent='Clipboard unavailable. Select the values above and copy manually.';
      }
    });
    document.getElementById('manual-ppi')?.addEventListener('submit',event=>{
      event.preventDefault();
      const result=document.getElementById('ppi-result');
      const width=Number(document.getElementById('native-width')?.value);
      const height=Number(document.getElementById('native-height')?.value);
      const diagonal=Number(document.getElementById('native-diagonal')?.value);
      const confirmed=document.getElementById('native-confirmed')?.checked;
      if(!confirmed){
        if(result)result.textContent='Confirm the native physical pixel resolution before calculating PPI.';
        return;
      }
      if(!Number.isInteger(width)||!Number.isInteger(height)||width<1||height<1||width>20000||height>20000||!Number.isFinite(diagonal)||diagonal<0.1||diagonal>300){
        if(result)result.textContent='Enter positive native pixel dimensions (1–20,000) and a valid diagonal size (0.1–300 inches).';
        return;
      }
      const ppi=Math.hypot(width,height)/diagonal;
      if(result)result.textContent='Calculated density: '+ppi.toFixed(2)+' PPI (from your supplied native resolution and diagonal; not a hardware measurement).';
    });
    update();
  })();
  </script>}
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found | DeadPixelTest" description="This screen testing page does not exist." canonicalPath="/404" noindex>
  <main id="main-content" tabindex="-1" class="max-w-xl mx-auto px-6 py-24 text-center">
    <p class="text-blue-400 uppercase tracking-widest text-sm font-bold">404</p>
    <h1 class="mt-4 text-4xl font-bold">Page not found</h1>
    <p class="text-[#475569] mt-5 leading-8">The page you requested might have moved, or the address may be incorrect.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-lg bg-blue-600 text-white px-5 py-3 font-semibold hover:bg-blue-500">Dead Pixel Test</a>
      <a href="/tests/refresh-rate" class="rounded-lg border border-[#CBD5E1] bg-white text-[#101827] px-5 py-3 hover:border-[#125CC9]">Refresh Rate Test</a>
    </div>
  </main>
</BaseLayout>
